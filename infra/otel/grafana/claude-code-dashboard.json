{
  "uid": "claude-code",
  "title": "Claude Code Telemetry",
  "tags": ["claude-code", "otel"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "총 비용 (USD)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 3 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(claude_code_cost_usage_USD_total)", "instant": true }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "세션 수",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(claude_code_session_count_total)", "instant": true }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "총 토큰",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(claude_code_token_usage_tokens_total)", "instant": true }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "활동 시간",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(claude_code_active_time_seconds_total)", "instant": true }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "모델별 누적 비용 (USD)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (model) (claude_code_cost_usage_USD_total)", "legendFormat": "{{model}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "타입별 누적 토큰",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (type) (claude_code_token_usage_tokens_total)", "legendFormat": "{{type}}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "이벤트 발생 빈도 (event_name별)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (event_name) (count_over_time({service_name=\"claude-code\"} [$__auto]))", "legendFormat": "{{event_name}}" }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "이벤트 로그 스트림",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "expr": "{service_name=\"claude-code\"}" }
      ]
    }
  ]
}
