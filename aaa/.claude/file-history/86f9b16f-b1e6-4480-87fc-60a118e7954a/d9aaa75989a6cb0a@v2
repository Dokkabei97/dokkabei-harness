#!/usr/bin/env bash
#
# Plane CLI — Live E2E Test Suite
#
# 실제 Plane API를 대상으로 모든 CLI 커맨드의 동작을 검증합니다.
# 테스트용 리소스를 생성 → 조회 → 수정 → 삭제하는 전체 CRUD 사이클을 실행합니다.
#
# 사용법:
#   ./tests/e2e/run_e2e.sh              # 전체 테스트
#   ./tests/e2e/run_e2e.sh --readonly   # 읽기 전용 테스트만
#
# 필요 조건:
#   - ~/.config/plane-cli/config.yaml에 api_key, base_url, workspace, project 설정
#   - ./plane 바이너리 빌드 완료 (make build)
#   - jq 설치 필요

set -euo pipefail

######################################################################
# Configuration
######################################################################
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
PLANE="$PROJECT_ROOT/plane"
READONLY_ONLY="${1:-}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# Counters
PASS=0
FAIL=0
SKIP=0
UNAVAIL=0
TOTAL=0
FAILED_TESTS=()
UNAVAIL_TESTS=()

######################################################################
# Helpers — 모든 상태 출력은 stderr로, stdout은 데이터 전용
######################################################################

log_section() {
  echo "" >&2
  echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}" >&2
  echo -e "${BOLD}  $1${NC}" >&2
  echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}" >&2
}

# run_test: 실행 후 pass/fail 출력 (stdout에 명령 출력 반환)
run_test() {
  local test_name="$1"
  shift
  TOTAL=$((TOTAL + 1))

  local output exit_code=0
  output=$("$@" 2>&1) || exit_code=$?

  if [ $exit_code -eq 0 ]; then
    PASS=$((PASS + 1))
    echo -e "  ${GREEN}✓${NC} ${test_name}" >&2
  else
    # 404 = API가 이 Plane 인스턴스에서 지원되지 않음
    if echo "$output" | grep -q "404 Not Found"; then
      UNAVAIL=$((UNAVAIL + 1))
      UNAVAIL_TESTS+=("$test_name")
      echo -e "  ${BLUE}⊘${NC} ${test_name} ${BLUE}(API 미지원)${NC}" >&2
    else
      FAIL=$((FAIL + 1))
      FAILED_TESTS+=("$test_name")
      echo -e "  ${RED}✗${NC} ${test_name}" >&2
      echo -e "    ${RED}Exit: $exit_code | $(echo "$output" | head -1)${NC}" >&2
    fi
  fi

  echo "$output"
}

# run_test_expect_fail: 실패를 기대하는 테스트
run_test_expect_fail() {
  local test_name="$1"
  shift
  TOTAL=$((TOTAL + 1))

  local output exit_code=0
  output=$("$@" 2>&1) || exit_code=$?

  if [ $exit_code -ne 0 ]; then
    PASS=$((PASS + 1))
    echo -e "  ${GREEN}✓${NC} ${test_name} (expected failure)" >&2
  else
    FAIL=$((FAIL + 1))
    FAILED_TESTS+=("$test_name")
    echo -e "  ${RED}✗${NC} ${test_name} (should have failed)" >&2
  fi
}

skip_test() {
  local test_name="$1"
  TOTAL=$((TOTAL + 1))
  SKIP=$((SKIP + 1))
  echo -e "  ${YELLOW}○${NC} ${test_name} (skipped)" >&2
}

extract_id() {
  echo "$1" | jq -r '.id // empty' 2>/dev/null || echo ""
}

# JSON 응답에서 첫 번째 항목 ID 추출 (paginated .results[] 또는 flat array [])
first_id() {
  echo "$1" | jq -r '(.results[0].id // .[0].id // empty)' 2>/dev/null || echo ""
}

# 테스트가 API 미지원(404)인지 확인
is_unavailable() {
  echo "$1" | grep -q "404 Not Found"
}

######################################################################
# Pre-flight checks
######################################################################

echo -e "${BOLD}Plane CLI — Live E2E Test Suite${NC}" >&2
echo "" >&2

if [ ! -x "$PLANE" ]; then
  echo -e "${RED}Error: plane binary not found at $PLANE${NC}" >&2
  echo "Run 'make build' first." >&2
  exit 1
fi

if ! command -v jq &>/dev/null; then
  echo -e "${RED}Error: jq is required. Install with: brew install jq${NC}" >&2
  exit 1
fi

echo -e "Binary:    ${PLANE}" >&2
echo -e "Mode:      ${READONLY_ONLY:-full (read + write)}" >&2
echo -e "Timestamp: $(date '+%Y-%m-%d %H:%M:%S')" >&2

######################################################################
# 0. Standalone Commands
######################################################################
log_section "0. Standalone Commands"

run_test "version" $PLANE version >/dev/null
run_test "config get base_url" $PLANE config get base_url >/dev/null
run_test "help" $PLANE --help >/dev/null
run_test "issue --help" $PLANE issue --help >/dev/null

######################################################################
# 1. User
######################################################################
log_section "1. User"

run_test "user me" $PLANE user me >/dev/null

######################################################################
# 2. Project (read-only)
######################################################################
log_section "2. Project"

PROJECT_LIST=$(run_test "project list" $PLANE project list)
FIRST_PROJECT_ID=$(first_id "$PROJECT_LIST")

if [ -n "$FIRST_PROJECT_ID" ]; then
  run_test "project get" $PLANE project get "$FIRST_PROJECT_ID" >/dev/null
else
  skip_test "project get (no projects)"
fi

######################################################################
# 3. State (read-only)
######################################################################
log_section "3. State"

STATE_LIST=$(run_test "state list" $PLANE state list)
FIRST_STATE_ID=$(first_id "$STATE_LIST")

if [ -n "$FIRST_STATE_ID" ]; then
  run_test "state get" $PLANE state get "$FIRST_STATE_ID" >/dev/null
else
  skip_test "state get (no states)"
fi

######################################################################
# 4. Label (read-only)
######################################################################
log_section "4. Label"

LABEL_LIST=$(run_test "label list" $PLANE label list)
FIRST_LABEL_ID=$(first_id "$LABEL_LIST")

if [ -n "$FIRST_LABEL_ID" ]; then
  run_test "label get" $PLANE label get "$FIRST_LABEL_ID" >/dev/null
else
  skip_test "label get (no labels)"
fi

######################################################################
# 5. Member
######################################################################
log_section "5. Member"

run_test "member list" $PLANE member list >/dev/null
run_test "member list-project" $PLANE member list-project >/dev/null

######################################################################
# 6. Issue (read-only)
######################################################################
log_section "6. Issue (Read-Only)"

ISSUE_LIST=$(run_test "issue list" $PLANE issue list)
FIRST_ISSUE_ID=$(first_id "$ISSUE_LIST")

if [ -n "$FIRST_ISSUE_ID" ]; then
  run_test "issue get" $PLANE issue get "$FIRST_ISSUE_ID" >/dev/null
  run_test "issue search --query test" $PLANE issue search --query test >/dev/null
else
  skip_test "issue get (no issues)"
  skip_test "issue search (no issues)"
fi

######################################################################
# 7. Cycle (read-only)
######################################################################
log_section "7. Cycle (Read-Only)"

CYCLE_LIST=$(run_test "cycle list" $PLANE cycle list)
FIRST_CYCLE_ID=$(first_id "$CYCLE_LIST")

if [ -n "$FIRST_CYCLE_ID" ]; then
  run_test "cycle get" $PLANE cycle get "$FIRST_CYCLE_ID" >/dev/null
  run_test "cycle list-items" $PLANE cycle list-items "$FIRST_CYCLE_ID" >/dev/null
else
  skip_test "cycle get (no cycles)"
  skip_test "cycle list-items (no cycles)"
fi

######################################################################
# 8. Module (read-only)
######################################################################
log_section "8. Module (Read-Only)"

MODULE_LIST=$(run_test "module list" $PLANE module list)
FIRST_MODULE_ID=$(first_id "$MODULE_LIST")

if [ -n "$FIRST_MODULE_ID" ]; then
  run_test "module get" $PLANE module get "$FIRST_MODULE_ID" >/dev/null
  run_test "module list-items" $PLANE module list-items "$FIRST_MODULE_ID" >/dev/null
else
  skip_test "module get (no modules)"
  skip_test "module list-items (no modules)"
fi

######################################################################
# 9. Epic
######################################################################
log_section "9. Epic"

EPIC_LIST=$(run_test "epic list" $PLANE epic list)

if ! is_unavailable "$EPIC_LIST"; then
  FIRST_EPIC_ID=$(first_id "$EPIC_LIST")
  if [ -n "$FIRST_EPIC_ID" ]; then
    run_test "epic get" $PLANE epic get "$FIRST_EPIC_ID" >/dev/null
  else
    skip_test "epic get (no epics)"
  fi
else
  skip_test "epic get (API 미지원)"
fi

######################################################################
# 10. Initiative
######################################################################
log_section "10. Initiative"

INIT_LIST=$(run_test "initiative list" $PLANE initiative list)

if ! is_unavailable "$INIT_LIST"; then
  FIRST_INIT_ID=$(first_id "$INIT_LIST")
  if [ -n "$FIRST_INIT_ID" ]; then
    run_test "initiative get" $PLANE initiative get "$FIRST_INIT_ID" >/dev/null
  else
    skip_test "initiative get (no initiatives)"
  fi
else
  skip_test "initiative get (API 미지원)"
fi

######################################################################
# 11. Page
######################################################################
log_section "11. Page"

skip_test "page (CRUD 섹션에서 테스트)"

######################################################################
# 12. Intake
######################################################################
log_section "12. Intake"

INTAKE_LIST=$(run_test "intake list" $PLANE intake list)

if ! is_unavailable "$INTAKE_LIST"; then
  FIRST_INTAKE_ID=$(first_id "$INTAKE_LIST")
  if [ -n "$FIRST_INTAKE_ID" ]; then
    run_test "intake get" $PLANE intake get "$FIRST_INTAKE_ID" >/dev/null
    run_test "intake list-issues" $PLANE intake list-issues "$FIRST_INTAKE_ID" >/dev/null
  else
    skip_test "intake get (no intakes)"
    skip_test "intake list-issues (no intakes)"
  fi
else
  skip_test "intake get (API 미지원)"
  skip_test "intake list-issues (API 미지원)"
fi

######################################################################
# 13. Sticky
######################################################################
log_section "13. Sticky"

STICKY_LIST=$(run_test "sticky list" $PLANE sticky list)

if ! is_unavailable "$STICKY_LIST"; then
  FIRST_STICKY_ID=$(first_id "$STICKY_LIST")
  if [ -n "$FIRST_STICKY_ID" ]; then
    run_test "sticky get" $PLANE sticky get "$FIRST_STICKY_ID" >/dev/null
  else
    skip_test "sticky get (no stickies)"
  fi
else
  skip_test "sticky get (API 미지원)"
fi

######################################################################
# 14. Teamspace
######################################################################
log_section "14. Teamspace"

TS_LIST=$(run_test "teamspace list" $PLANE teamspace list)

if ! is_unavailable "$TS_LIST"; then
  FIRST_TS_ID=$(first_id "$TS_LIST")
  if [ -n "$FIRST_TS_ID" ]; then
    run_test "teamspace get" $PLANE teamspace get "$FIRST_TS_ID" >/dev/null
  else
    skip_test "teamspace get (no teamspaces)"
  fi
else
  skip_test "teamspace get (API 미지원)"
fi

######################################################################
# 15. Customer
######################################################################
log_section "15. Customer"

CUST_LIST=$(run_test "customer list" $PLANE customer list)

if ! is_unavailable "$CUST_LIST"; then
  FIRST_CUST_ID=$(first_id "$CUST_LIST")
  if [ -n "$FIRST_CUST_ID" ]; then
    run_test "customer get" $PLANE customer get "$FIRST_CUST_ID" >/dev/null
  else
    skip_test "customer get (no customers)"
  fi
else
  skip_test "customer get (API 미지원)"
fi

######################################################################
# 16. Validation Tests (expected failures)
######################################################################
log_section "16. Validation (Expected Failures)"

run_test_expect_fail "issue create without --name" $PLANE issue create
run_test_expect_fail "issue search without --query" $PLANE issue search
run_test_expect_fail "issue update without fields" $PLANE issue update fake-id
run_test_expect_fail "label create without --name" $PLANE label create
run_test_expect_fail "state create without --name" $PLANE state create

######################################################################
# WRITE TESTS — CRUD Lifecycle
######################################################################

if [ "$READONLY_ONLY" = "--readonly" ]; then
  log_section "CRUD Tests (Skipped — readonly mode)"
  echo -e "  ${YELLOW}Use without --readonly to run CRUD tests${NC}" >&2
else

  ####################################################################
  # W1. Label CRUD
  ####################################################################
  log_section "W1. Label CRUD Lifecycle"

  LABEL_CREATE=$(run_test "label create" $PLANE label create --name "E2E-Test-Label-$(date +%s)" --color "#FF5733")
  TEST_LABEL_ID=$(extract_id "$LABEL_CREATE")

  if [ -n "$TEST_LABEL_ID" ]; then
    run_test "label get (created)" $PLANE label get "$TEST_LABEL_ID" >/dev/null
    run_test "label update" $PLANE label update "$TEST_LABEL_ID" --color "#00FF00" >/dev/null
    run_test "label delete" $PLANE label delete "$TEST_LABEL_ID" >/dev/null
  else
    skip_test "label get (create failed)"
    skip_test "label update (create failed)"
    skip_test "label delete (create failed)"
  fi

  ####################################################################
  # W2. State CRUD
  ####################################################################
  log_section "W2. State CRUD Lifecycle"

  STATE_CREATE=$(run_test "state create" $PLANE state create --name "E2E-Test-State-$(date +%s)" --group backlog --color "#AABBCC")
  TEST_STATE_ID=$(extract_id "$STATE_CREATE")

  if [ -n "$TEST_STATE_ID" ]; then
    run_test "state get (created)" $PLANE state get "$TEST_STATE_ID" >/dev/null
    run_test "state update" $PLANE state update "$TEST_STATE_ID" --name "E2E-State-Updated" >/dev/null
    run_test "state delete" $PLANE state delete "$TEST_STATE_ID" >/dev/null
  else
    skip_test "state get (create failed)"
    skip_test "state update (create failed)"
    skip_test "state delete (create failed)"
  fi

  ####################################################################
  # W3. Issue CRUD (+ Comment, Link, Activity, Worklog)
  ####################################################################
  log_section "W3. Issue CRUD Lifecycle"

  ISSUE_CREATE=$(run_test "issue create" $PLANE issue create --name "E2E Test Issue $(date +%s)" --priority low --description "<p>E2E test</p>")
  TEST_ISSUE_ID=$(extract_id "$ISSUE_CREATE")

  if [ -n "$TEST_ISSUE_ID" ]; then
    run_test "issue get (created)" $PLANE issue get "$TEST_ISSUE_ID" >/dev/null
    run_test "issue update" $PLANE issue update "$TEST_ISSUE_ID" --name "E2E Issue Updated" --priority high >/dev/null

    # ── Comment CRUD ──
    log_section "W3a. Comment CRUD"

    COMMENT_CREATE=$(run_test "comment create" $PLANE comment create --issue "$TEST_ISSUE_ID" --body "<p>E2E comment</p>")
    TEST_COMMENT_ID=$(extract_id "$COMMENT_CREATE")

    run_test "comment list" $PLANE comment list --issue "$TEST_ISSUE_ID" >/dev/null

    if [ -n "$TEST_COMMENT_ID" ]; then
      run_test "comment get" $PLANE comment get "$TEST_COMMENT_ID" --issue "$TEST_ISSUE_ID" >/dev/null
      run_test "comment update" $PLANE comment update "$TEST_COMMENT_ID" --issue "$TEST_ISSUE_ID" --body "<p>Updated</p>" >/dev/null
      run_test "comment delete" $PLANE comment delete "$TEST_COMMENT_ID" --issue "$TEST_ISSUE_ID" >/dev/null
    else
      skip_test "comment get (create failed)"
      skip_test "comment update (create failed)"
      skip_test "comment delete (create failed)"
    fi

    # ── Link CRUD ──
    log_section "W3b. Link CRUD"

    LINK_CREATE=$(run_test "link create" $PLANE link create --issue "$TEST_ISSUE_ID" --title "E2E Link" --url "https://example.com/e2e")
    TEST_LINK_ID=$(extract_id "$LINK_CREATE")

    run_test "link list" $PLANE link list --issue "$TEST_ISSUE_ID" >/dev/null

    if [ -n "$TEST_LINK_ID" ]; then
      run_test "link get" $PLANE link get "$TEST_LINK_ID" --issue "$TEST_ISSUE_ID" >/dev/null
      run_test "link update" $PLANE link update "$TEST_LINK_ID" --issue "$TEST_ISSUE_ID" --title "Updated Link" >/dev/null
      run_test "link delete" $PLANE link delete "$TEST_LINK_ID" --issue "$TEST_ISSUE_ID" >/dev/null
    else
      skip_test "link get (create failed)"
      skip_test "link update (create failed)"
      skip_test "link delete (create failed)"
    fi

    # ── Activity ──
    log_section "W3c. Activity"
    run_test "activity list" $PLANE activity list --issue "$TEST_ISSUE_ID" >/dev/null

    # ── Worklog CRUD ──
    log_section "W3d. Worklog CRUD"

    WORKLOG_CREATE=$(run_test "worklog create" $PLANE worklog create --issue "$TEST_ISSUE_ID" --duration 1 --description "E2E worklog")

    if ! is_unavailable "$WORKLOG_CREATE"; then
      TEST_WORKLOG_ID=$(extract_id "$WORKLOG_CREATE")
      run_test "worklog list" $PLANE worklog list --issue "$TEST_ISSUE_ID" >/dev/null
      run_test "worklog total" $PLANE worklog total --issue "$TEST_ISSUE_ID" >/dev/null

      if [ -n "$TEST_WORKLOG_ID" ]; then
        run_test "worklog get" $PLANE worklog get "$TEST_WORKLOG_ID" --issue "$TEST_ISSUE_ID" >/dev/null
        run_test "worklog update" $PLANE worklog update "$TEST_WORKLOG_ID" --issue "$TEST_ISSUE_ID" --duration 2 >/dev/null
        run_test "worklog delete" $PLANE worklog delete "$TEST_WORKLOG_ID" --issue "$TEST_ISSUE_ID" >/dev/null
      else
        skip_test "worklog get (create failed)"
        skip_test "worklog update (create failed)"
        skip_test "worklog delete (create failed)"
      fi
    else
      skip_test "worklog list (API 미지원)"
      skip_test "worklog total (API 미지원)"
      skip_test "worklog get (API 미지원)"
      skip_test "worklog update (API 미지원)"
      skip_test "worklog delete (API 미지원)"
    fi

    # Cleanup: delete the test issue
    run_test "issue delete (cleanup)" $PLANE issue delete "$TEST_ISSUE_ID" >/dev/null
  else
    echo -e "  ${RED}Issue create failed — skipping related tests${NC}" >&2
    for t in "issue get" "issue update" "comment CRUD" "link CRUD" "activity" "worklog CRUD" "issue delete"; do
      skip_test "$t (issue create failed)"
    done
  fi

  ####################################################################
  # W4. Cycle CRUD
  ####################################################################
  log_section "W4. Cycle CRUD Lifecycle"

  CYCLE_CREATE=$(run_test "cycle create" $PLANE cycle create --name "E2E-Cycle-$(date +%s)" --start-date "2026-04-01" --end-date "2026-04-30")
  TEST_CYCLE_ID=$(extract_id "$CYCLE_CREATE")

  if [ -n "$TEST_CYCLE_ID" ]; then
    run_test "cycle get (created)" $PLANE cycle get "$TEST_CYCLE_ID" >/dev/null
    run_test "cycle update" $PLANE cycle update "$TEST_CYCLE_ID" --name "E2E-Cycle-Updated" >/dev/null
    run_test "cycle delete" $PLANE cycle delete "$TEST_CYCLE_ID" >/dev/null
  else
    skip_test "cycle get (create failed)"
    skip_test "cycle update (create failed)"
    skip_test "cycle delete (create failed)"
  fi

  ####################################################################
  # W5. Module CRUD
  ####################################################################
  log_section "W5. Module CRUD Lifecycle"

  MODULE_CREATE=$(run_test "module create" $PLANE module create --name "E2E-Module-$(date +%s)")
  TEST_MODULE_ID=$(extract_id "$MODULE_CREATE")

  if [ -n "$TEST_MODULE_ID" ]; then
    run_test "module get (created)" $PLANE module get "$TEST_MODULE_ID" >/dev/null
    run_test "module update" $PLANE module update "$TEST_MODULE_ID" --name "E2E-Module-Updated" >/dev/null
    run_test "module delete" $PLANE module delete "$TEST_MODULE_ID" >/dev/null
  else
    skip_test "module get (create failed)"
    skip_test "module update (create failed)"
    skip_test "module delete (create failed)"
  fi

  ####################################################################
  # W6. Sticky CRUD
  ####################################################################
  log_section "W6. Sticky CRUD Lifecycle"

  STICKY_CREATE=$(run_test "sticky create" $PLANE sticky create --name "E2E-Sticky-$(date +%s)")

  if ! is_unavailable "$STICKY_CREATE"; then
    TEST_STICKY_ID=$(extract_id "$STICKY_CREATE")
    if [ -n "$TEST_STICKY_ID" ]; then
      run_test "sticky get (created)" $PLANE sticky get "$TEST_STICKY_ID" >/dev/null
      run_test "sticky update" $PLANE sticky update "$TEST_STICKY_ID" --name "E2E-Sticky-Updated" >/dev/null
      run_test "sticky delete" $PLANE sticky delete "$TEST_STICKY_ID" >/dev/null
    else
      skip_test "sticky get (create failed)"
      skip_test "sticky update (create failed)"
      skip_test "sticky delete (create failed)"
    fi
  else
    skip_test "sticky get (API 미지원)"
    skip_test "sticky update (API 미지원)"
    skip_test "sticky delete (API 미지원)"
  fi

  ####################################################################
  # W7. Initiative CRUD
  ####################################################################
  log_section "W7. Initiative CRUD Lifecycle"

  INIT_CREATE=$(run_test "initiative create" $PLANE initiative create --name "E2E-Initiative-$(date +%s)")

  if ! is_unavailable "$INIT_CREATE"; then
    TEST_INIT_ID=$(extract_id "$INIT_CREATE")
    if [ -n "$TEST_INIT_ID" ]; then
      run_test "initiative get (created)" $PLANE initiative get "$TEST_INIT_ID" >/dev/null
      run_test "initiative update" $PLANE initiative update "$TEST_INIT_ID" --name "E2E-Init-Updated" >/dev/null
      run_test "initiative delete" $PLANE initiative delete "$TEST_INIT_ID" >/dev/null
    else
      skip_test "initiative get (create failed)"
      skip_test "initiative update (create failed)"
      skip_test "initiative delete (create failed)"
    fi
  else
    skip_test "initiative get (API 미지원)"
    skip_test "initiative update (API 미지원)"
    skip_test "initiative delete (API 미지원)"
  fi

  ####################################################################
  # W8. Page
  ####################################################################
  log_section "W8. Page"

  PAGE_CREATE=$(run_test "page create" $PLANE page create --name "E2E-Page-$(date +%s)")

  if ! is_unavailable "$PAGE_CREATE"; then
    TEST_PAGE_ID=$(extract_id "$PAGE_CREATE")
    if [ -n "$TEST_PAGE_ID" ]; then
      run_test "page get (created)" $PLANE page get "$TEST_PAGE_ID" >/dev/null
    else
      skip_test "page get (create failed)"
    fi
  else
    skip_test "page get (API 미지원)"
  fi

  ####################################################################
  # W9. Table format output
  ####################################################################
  log_section "W9. Table Format Output"

  run_test "issue list -f table" $PLANE issue list -f table >/dev/null
  run_test "project list -f table" $PLANE project list -f table >/dev/null
  run_test "state list -f table" $PLANE state list -f table >/dev/null

fi

######################################################################
# Summary
######################################################################
echo "" >&2
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}" >&2
echo -e "${BOLD}  TEST RESULTS${NC}" >&2
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}" >&2
echo "" >&2
echo -e "  Total:       ${BOLD}${TOTAL}${NC}" >&2
echo -e "  Passed:      ${GREEN}${PASS}${NC}" >&2
echo -e "  Failed:      ${RED}${FAIL}${NC}" >&2
echo -e "  API 미지원:  ${BLUE}${UNAVAIL}${NC}" >&2
echo -e "  Skipped:     ${YELLOW}${SKIP}${NC}" >&2
echo "" >&2

if [ ${#UNAVAIL_TESTS[@]} -gt 0 ]; then
  echo -e "${BLUE}  API 미지원 (Plane 인스턴스에서 지원하지 않는 엔드포인트):${NC}" >&2
  for t in "${UNAVAIL_TESTS[@]}"; do
    echo -e "    ${BLUE}⊘${NC} $t" >&2
  done
  echo "" >&2
fi

if [ ${#FAILED_TESTS[@]} -gt 0 ]; then
  echo -e "${RED}  실패한 테스트 (CLI 버그 가능성):${NC}" >&2
  for t in "${FAILED_TESTS[@]}"; do
    echo -e "    ${RED}✗${NC} $t" >&2
  done
  echo "" >&2
fi

if [ $FAIL -eq 0 ]; then
  echo -e "  ${GREEN}${BOLD}지원되는 모든 API 테스트 통과!${NC}" >&2
  exit 0
else
  echo -e "  ${RED}${BOLD}일부 테스트 실패.${NC}" >&2
  exit 1
fi
