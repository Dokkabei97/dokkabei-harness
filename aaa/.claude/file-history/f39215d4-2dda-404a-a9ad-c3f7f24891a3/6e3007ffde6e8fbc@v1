## Python 코드
```python
from dataclasses import dataclass
from typing import Any, Dict, List
import asyncio

@dataclass
class Candidate:
    id: str
    title: str
    url: str
    snippet: str
    score: float
    source: str

@dataclass
class FinalResponse:
    summary: str
    key_points: List[str]
    blue_links: List[dict]
    citations: List[str]
    fallback: bool = False

async def classify_intent(query: str) -> str:
    # LLM/규칙/학습모델 조합 인터페이스
    await asyncio.sleep(0)  # placeholder
    # Informational / Navigational / Transactional / CI
    return "Informational"

async def search_hybrid(query: str, strategy: str) -> List[Candidate]:
    # BM25 + Dense + Graph 등 동시 조회
    await asyncio.sleep(0)
    return [
        Candidate("d1", "문서A", "https://example.com/a", "요약", 0.91, "es"),
        Candidate("d2", "문서B", "https://example.com/b", "요약", 0.88, "milvus"),
    ]

def rerank(cands: List[Candidate]) -> List[Candidate]:
    # freshness, trust, intent-match 반영
    return sorted(cands, key=lambda c: c.score, reverse=True)

def build_blue_links(cands: List[Candidate], top_k: int = 10) -> List[dict]:
    links = []
    for rank, c in enumerate(cands[:top_k], start=1):
        links.append({"rank": rank, "title": c.title, "url": c.url, "source": c.source})
    while len(links) < top_k:
        links.append({"rank": len(links)+1, "title": "cache fallback", "url": "", "source": "cache"})
    return links

async def summarize(cands: List[Candidate]) -> str:
    await asyncio.sleep(0)
    return "핵심 결과: 검색 대상이 요구된 주제를 설명하는 근거를 문헌 기반으로 정리함."

async def stream_response(query: str) -> FinalResponse:
    intent = await classify_intent(query)
    cands = await search_hybrid(query, intent)
    ranked = rerank(cands)
    final = FinalResponse(
        summary=await summarize(ranked[:10]),
        key_points=[c.snippet for c in ranked[:3]],
        blue_links=build_blue_links(ranked, top_k=10),
        citations=[f"{c.id}@{c.url}" for c in ranked[:5]],
        fallback=len(ranked) < 10
    )
    return final
```

