package com.cowave.search.application.index.service.proxy

import com.cowave.search.application.index.property.LocalCacheProperties
import com.cowave.search.domain.proxy.category.CategoryProjection
import com.cowave.search.domain.proxy.category.CategoryProxyReader
import com.cowave.search.domain.proxy.category.CategoryRepository
import com.cowave.shared.cache.GlobalCache
import com.cowave.shared.cache.LocalCacheFactory
import com.cowave.shared.cache.TieredLoadingCacheFactory
import org.springframework.stereotype.Service

@Service
class CategoryApplicationService(
    private val categoryProxyReader: CategoryProxyReader,
    private val categoryRepository: CategoryRepository,
    categoryGlobalCache: GlobalCache<Int, CategoryProjection>,
    localCacheProperties: LocalCacheProperties,
) {
    private val localCache =
        LocalCacheFactory.create<Int, CategoryProjection>(
            keyPrefix = LOCAL_CACHE_KEY_PREFIX,
            ttlSeconds = localCacheProperties.category.ttlSeconds,
        )

    private val tieredCache =
        TieredLoadingCacheFactory.create(
            localCache = localCache,
            globalCache = categoryGlobalCache,
            fetcher = { ids -> categoryProxyReader.getAllByIds(ids.toList()).associateBy { it.id } },
            cacheName = "category",
        )

    fun getCachedAllByIds(ids: List<Int>): Map<Int, CategoryProjection> =
        tieredCache.getAll(ids)
            .filterValues { it != null }
            .mapValues { it.value!! }

    fun getAllByIds(ids: List<Int>): List<CategoryProjection> =
        if (ids.isEmpty()) emptyList()
        else categoryRepository.getAllByIds(ids)

    companion object {
        const val LOCAL_CACHE_KEY_PREFIX = "local.search-api.category"
    }
}
