package com.cowave.search.application.index.service.proxy

import com.cowave.search.application.index.property.LocalCacheProperties
import com.cowave.search.domain.proxy.brand.BrandProjection
import com.cowave.search.domain.proxy.brand.BrandProxyReader
import com.cowave.search.domain.proxy.brand.BrandRepository
import com.cowave.shared.cache.GlobalCache
import com.cowave.shared.cache.LocalCacheFactory
import com.cowave.shared.cache.TieredLoadingCacheFactory
import org.springframework.stereotype.Service

@Service
class BrandApplicationService(
    private val brandProxyReader: BrandProxyReader,
    private val brandRepository: BrandRepository,
    brandGlobalCache: GlobalCache<Long, BrandProjection>,
    localCacheProperties: LocalCacheProperties,
) {
    private val localCache =
        LocalCacheFactory.create<Long, BrandProjection>(
            keyPrefix = LOCAL_CACHE_KEY_PREFIX,
            ttlSeconds = localCacheProperties.brand.ttlSeconds,
        )

    private val tieredCache =
        TieredLoadingCacheFactory.create(
            localCache = localCache,
            globalCache = brandGlobalCache,
            fetcher = { ids -> brandProxyReader.getAllByIds(ids.toList()).associateBy { it.id } },
            cacheName = "brand",
        )

    fun getCachedAllByIds(ids: List<Long>): Map<Long, BrandProjection> =
        tieredCache.getAll(ids)
            .filterValues { it != null }
            .mapValues { it.value!! }

    fun getAllByIds(ids: List<Long>): List<BrandProjection> =
        if (ids.isEmpty()) emptyList()
        else brandRepository.getAllByIds(ids)

    companion object {
        const val LOCAL_CACHE_KEY_PREFIX = "local.search-api.brand"
    }
}