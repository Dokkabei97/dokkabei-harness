package com.cowave.shared.cache

import io.github.oshai.kotlinlogging.KotlinLogging

/**
 * 각 cache, fetcher 마다 사용하는 key의 형태가 다르기 때문에 공통의 id를 key로써 사용하고 캐시의 실제 키는 각 캐시 내부에서 처리합니다.
 */
class DefaultTieredLoadingCache<ID, V>(
    private val localCache: LocalCache<ID, V>,
    private val globalCache: GlobalCache<ID, V>,
    private val fetcher: (Collection<ID>) -> Map<ID, V>,
    private val cacheName: String = "unknown",
) : TieredLoadingCache<ID, V> {
    private val logger = KotlinLogging.logger("TieredCache.$cacheName")

    override fun get(id: ID): V? {
        // 1. L1
        localCache.get(id)?.let {
            logger.debug { "[$cacheName] L1 HIT id=$id" }
            return it
        }

        // 2. L2
        val globalCached = globalCache.getAll(listOf(id))
        globalCached[id]?.let {
            localCache.put(id, it)
            logger.info { "[$cacheName] L2(Valkey) HIT → L1 promote id=$id" }
            return it
        }

        // 3. L3
        val fetched = fetcher(listOf(id))
        fetched[id]?.let {
            localCache.put(id, it)
            globalCache.putAll(mapOf(id to it))
            logger.info { "[$cacheName] L3(Proxy) FETCH → L1+L2 write-back id=$id" }
            return it
        }

        // 4. All missed
        logger.debug { "[$cacheName] ALL MISS id=$id" }
        return null
    }

    override fun getAll(ids: Collection<ID>): Map<ID, V?> {
        if (ids.isEmpty()) return emptyMap()

        // 1. L1
        val localCached = localCache.getAll(ids)
        val localHit = localCached.filterValues { it != null }
        val localMiss = localCached.filterValues { it == null }
        if (localMiss.keys.isEmpty()) {
            logger.info { "[$cacheName] L1 ALL HIT [count=${ids.size}]" }
            return localCached
        }
        if (localHit.isNotEmpty()) {
            logger.info { "[$cacheName] L1 partial HIT [hit=${localHit.size}, miss=${localMiss.size}]" }
        }

        // 2. L2
        val globalCached = globalCache.getAll(localMiss.keys)
        val globalHit = globalCached.filterValues { it != null }.mapValues { it.value!! }
        val globalMiss = globalCached.filterValues { it == null }
        if (globalHit.isNotEmpty()) {
            localCache.putAll(globalHit)
            logger.info { "[$cacheName] L2(Valkey) HIT → L1 promote [count=${globalHit.size}, ids=${globalHit.keys}]" }
        }
        if (globalMiss.isEmpty()) return localCached + globalCached

        // 3. L3
        logger.info { "[$cacheName] L2(Valkey) MISS [count=${globalMiss.size}, ids=${globalMiss.keys}]" }
        val fetched = fetcher(globalMiss.keys)
        if (fetched.isNotEmpty()) {
            localCache.putAll(fetched)
            globalCache.putAll(fetched)
            logger.info { "[$cacheName] L3(Proxy) FETCH → L1+L2 write-back [count=${fetched.size}, ids=${fetched.keys}]" }
        }
        val allMiss = globalMiss.keys - fetched.keys
        if (allMiss.isNotEmpty()) {
            logger.debug { "[$cacheName] ALL MISS (Proxy에 데이터 없음) [count=${allMiss.size}, ids=$allMiss]" }
        }

        return localCached + globalCached + fetched
    }
}
