package com.cowave.search.application.index.service.proxy

import com.cowave.search.application.index.property.LocalCacheProperties
import com.cowave.search.domain.proxy.mall.MallProjection
import com.cowave.search.domain.proxy.mall.MallProxyReader
import com.cowave.search.domain.proxy.mall.MallRepository
import com.cowave.shared.cache.GlobalCache
import com.cowave.shared.cache.LocalCacheFactory
import com.cowave.shared.cache.TieredLoadingCacheFactory
import org.springframework.stereotype.Service

@Service
class MallApplicationService(
    private val mallProxyReader: MallProxyReader,
    private val mallRepository: MallRepository,
    mallGlobalCache: GlobalCache<Int, MallProjection>,
    localCacheProperties: LocalCacheProperties,
) {
    private val localCache = LocalCacheFactory.create<Int, MallProjection>(
        keyPrefix = LOCAL_CACHE_KEY_PREFIX,
        ttlSeconds = localCacheProperties.mall.ttlSeconds,
    )

    private val tieredCache = TieredLoadingCacheFactory.create(
        localCache = localCache,
        globalCache = mallGlobalCache,
        fetcher = { ids -> mallProxyReader.getAllByIds(ids.toList()).associateBy { it.mallId } },
        cacheName = "mall",
    )

    fun getCachedAllByIds(ids: List<Int>): Map<Int, MallProjection> =
        tieredCache.getAll(ids)
            .filterValues { it != null }
            .mapValues { it.value!! }

    fun getAllByIds(ids: List<Int>): List<MallProjection> =
        if (ids.isEmpty()) emptyList()
        else mallRepository.getAllByIds(ids)

    companion object {
        const val LOCAL_CACHE_KEY_PREFIX = "local.search-api.mall"
    }
}