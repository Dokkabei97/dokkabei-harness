package com.cowave.search.application.index.service

import com.commerce.proxy.shopping.catalog.infrastructure.consumer.dto.Catalog
import com.cowave.search.application.index.repository.CatalogIndexRepository
import com.cowave.search.domain.index.dto.ChangedData
import com.cowave.search.domain.index.policy.CatalogEvaluator
import com.cowave.search.domain.index.policy.CatalogFilter
import com.cowave.search.domain.index.policy.CatalogMergeStrategy
import com.cowave.shared.domain.dto.IndexResult
class CatalogIndexApplicationService(
    private val catalogIndexRepository: CatalogIndexRepository,
    private val catalogAssembleService: CatalogAssembleService,
) {
    fun indexCatalogs(changedData: List<ChangedData<Catalog>>): IndexResult {
        val indexDocuments =
            changedData
                .filter(CatalogFilter::filter)
                .let(CatalogMergeStrategy::merge)
                .let { catalogAssembleService.assemble(it) }
                .filter(CatalogEvaluator::evaluate)

        return catalogIndexRepository.bulk(indexDocuments)
    }
}
