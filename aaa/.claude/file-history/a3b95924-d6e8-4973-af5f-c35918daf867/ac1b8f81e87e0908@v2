package com.cowave.search.application.index.config

import com.cowave.search.application.index.repository.CatalogIndexRepository
import com.cowave.search.application.index.repository.ProductIndexRepository
import com.cowave.search.application.index.service.CatalogAssembleService
import com.cowave.search.application.index.service.CatalogIndexApplicationService
import com.cowave.search.application.index.service.ProductAssembleService
import com.cowave.search.application.index.service.ProductIndexApplicationService
import com.cowave.search.application.index.service.proxy.CachedProxyApplicationService
import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty
import org.springframework.context.annotation.Bean
import org.springframework.context.annotation.Configuration

@Configuration
@ConditionalOnProperty(name = ["index.enabled"], havingValue = "true", matchIfMissing = false)
class IndexingApplicationConfig {

    @Bean
    fun catalogAssembleService(
        cachedProxyApplicationService: CachedProxyApplicationService,
    ) = CatalogAssembleService(cachedProxyApplicationService)

    @Bean
    fun productAssembleService(
        cachedProxyApplicationService: CachedProxyApplicationService,
    ) = ProductAssembleService(cachedProxyApplicationService)

    @Bean
    fun catalogIndexApplicationService(
        catalogIndexRepository: CatalogIndexRepository,
        catalogAssembleService: CatalogAssembleService,
    ) = CatalogIndexApplicationService(catalogIndexRepository, catalogAssembleService)

    @Bean
    fun productIndexApplicationService(
        productIndexRepository: ProductIndexRepository,
        productAssembleService: ProductAssembleService,
    ) = ProductIndexApplicationService(productIndexRepository, productAssembleService)
}
