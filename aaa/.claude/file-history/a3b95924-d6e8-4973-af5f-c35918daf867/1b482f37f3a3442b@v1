package com.cowave.search.application.index.service

import com.commerce.proxy.shopping.product.infrastructure.consumer.dto.Product
import com.cowave.search.application.index.repository.ProductIndexRepository
import com.cowave.search.domain.index.dto.ChangedData
import com.cowave.search.domain.index.policy.ProductEvaluator
import com.cowave.search.domain.index.policy.ProductFilter
import com.cowave.search.domain.index.policy.ProductMergeStrategy
import com.cowave.shared.domain.dto.IndexResult
import org.springframework.stereotype.Service

@Service
class ProductIndexApplicationService(
    private val productIndexRepository: ProductIndexRepository,
    private val productAssembleService: ProductAssembleService,
) {
    fun indexProducts(changedData: List<ChangedData<Product>>): IndexResult {
        val indexDocuments =
            changedData
                .filter(ProductFilter::filter)
                .let(ProductMergeStrategy::merge)
                .let { productAssembleService.assemble(it) }
                .filter(ProductEvaluator::evaluate)

        return productIndexRepository.bulk(indexDocuments)
    }
}
