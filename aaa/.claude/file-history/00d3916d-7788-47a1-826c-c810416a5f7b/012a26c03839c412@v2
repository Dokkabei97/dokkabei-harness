stages:
  - test
  - release

test:
  stage: test
  image: golang:1.22
  script:
    - go vet ./...
    - go test ./... -v -count=1

release:
  stage: release
  image:
    name: goreleaser/goreleaser:v2
    entrypoint: [""]
  rules:
    - if: $CI_COMMIT_TAG =~ /^v\d+\.\d+\.\d+/
  variables:
    GIT_DEPTH: 0
  script:
    - goreleaser release --clean
