func newCreateCmd(f *cmdutil.Factory) *cobra.Command {
	var name, description, startDate, targetDate, status, lead string
	var members []string

	cmd := &cobra.Command{
		Use:   "create",
		Short: "Create a new module",
		RunE: func(cmd *cobra.Command, args []string) error {
			if name == "" {
				return fmt.Errorf("--name is required")
			}

			client, err := f.Client()
			if err != nil {
				return err
			}
			ws, proj, err := f.RequireWorkspaceAndProject()
			if err != nil {
				return err
			}

			path, err := api.NewPath(modulePath()).
				Workspace(ws).Project(proj).Build()
			if err != nil {
				return err
			}

			body := map[string]interface{}{
				"name": name,
			}
			if description != "" {
				body["description"] = description
			}
			if startDate != "" {
				body["start_date"] = startDate
			}
			if targetDate != "" {
				body["target_date"] = targetDate
			}
			if status != "" {
				body["status"] = status
			}
			if lead != "" {
				body["lead"] = lead
			}
			if len(members) > 0 {
				body["members"] = members
			}

			resp, err := client.Post(path, body)
			if err != nil {
				return err
			}

			return output.FormatRaw(f.Format, resp, moduleColumns)
		},
	}

	cmd.Flags().StringVar(&name, "name", "", "Module name (required)")
	cmd.Flags().StringVar(&description, "description", "", "Module description")
	cmd.Flags().StringVar(&startDate, "start-date", "", "Start date (YYYY-MM-DD)")
	cmd.Flags().StringVar(&targetDate, "target-date", "", "Target date (YYYY-MM-DD)")
	cmd.Flags().StringVar(&status, "status", "", "Module status")
	cmd.Flags().StringVar(&lead, "lead", "", "Lead user ID")
	cmd.Flags().StringSliceVar(&members, "members", nil, "Member user IDs (comma-separated or repeated)")

	return cmd
}

func newUpdateCmd(f *cmdutil.Factory) *cobra.Command {
	var name, description, startDate, targetDate, status, lead string
	var members []string

	cmd := &cobra.Command{
		Use:   "update <module-id>",
		Short: "Update a module",
		Args:  cobra.ExactArgs(1),
		RunE: func(cmd *cobra.Command, args []string) error {
			client, err := f.Client()
			if err != nil {
				return err
			}
			ws, proj, err := f.RequireWorkspaceAndProject()
			if err != nil {
				return err
			}

			path, err := api.NewPath(modulePath()+"{module_id}/").
				Workspace(ws).Project(proj).Param("module_id", args[0]).Build()
			if err != nil {
				return err
			}

			body := make(map[string]interface{})
			if cmd.Flags().Changed("name") {
				body["name"] = name
			}
			if cmd.Flags().Changed("description") {
				body["description"] = description
			}
			if cmd.Flags().Changed("start-date") {
				body["start_date"] = startDate
			}
			if cmd.Flags().Changed("target-date") {
				body["target_date"] = targetDate
			}
			if cmd.Flags().Changed("status") {
				body["status"] = status
			}
			if cmd.Flags().Changed("lead") {
				body["lead"] = lead
			}
			if cmd.Flags().Changed("members") {
				body["members"] = members
			}

			if len(body) == 0 {
				return fmt.Errorf("at least one field must be specified to update")
			}

			resp, err := client.Patch(path, body)
			if err != nil {
				return err
			}

			return output.FormatRaw(f.Format, resp, moduleColumns)
		},
	}

	cmd.Flags().StringVar(&name, "name", "", "Module name")
	cmd.Flags().StringVar(&description, "description", "", "Module description")
	cmd.Flags().StringVar(&startDate, "start-date", "", "Start date (YYYY-MM-DD)")
	cmd.Flags().StringVar(&targetDate, "target-date", "", "Target date (YYYY-MM-DD)")
	cmd.Flags().StringVar(&status, "status", "", "Module status")
	cmd.Flags().StringVar(&lead, "lead", "", "Lead user ID")
	cmd.Flags().StringSliceVar(&members, "members", nil, "Member user IDs (comma-separated or repeated)")

	return cmd
}

