// NewCmd creates the module command.
func NewCmd(f *cmdutil.Factory) *cobra.Command {
	cmd := &cobra.Command{
		Use:     "module",
		Aliases: []string{"mod"},
		Short:   "Manage modules",
	}

	cmd.AddCommand(newListCmd(f))
	cmd.AddCommand(newGetCmd(f))
	cmd.AddCommand(newCreateCmd(f))
	cmd.AddCommand(newUpdateCmd(f))
	cmd.AddCommand(newDeleteCmd(f))
	cmd.AddCommand(newListItemsCmd(f))
	cmd.AddCommand(newAddItemsCmd(f))
	cmd.AddCommand(newRemoveItemCmd(f))
	cmd.AddCommand(newArchiveCmd(f))
	cmd.AddCommand(newUnarchiveCmd(f))

	return cmd
}

var moduleColumns = []output.Column{
	{Header: "ID", Field: "id"},
	{Header: "NAME", Field: "name"},
	{Header: "START_DATE", Field: "start_date"},
	{Header: "TARGET_DATE", Field: "target_date"},
	{Header: "STATUS", Field: "status"},
}

func modulePath() string {
	return "workspaces/{workspace_slug}/projects/{project_id}/modules/"
}

func newListCmd(f *cmdutil.Factory) *cobra.Command {
	return &cobra.Command{
		Use:   "list",
		Short: "List all modules in a project",
		RunE: func(cmd *cobra.Command, args []string) error {
			client, err := f.Client()
			if err != nil {
				return err
			}
			ws, proj, err := f.RequireWorkspaceAndProject()
			if err != nil {
				return err
			}

			path, err := api.NewPath(modulePath()).
				Workspace(ws).Project(proj).Build()
			if err != nil {
				return err
			}

			resp, err := client.Get(path)
			if err != nil {
				return err
			}

			return output.FormatRaw(f.Format, resp, moduleColumns)
		},
	}
}

