stages:
  - test
  - release

test:
  stage: test
  image: golang:1.22
  tags:
    - danuri
  script:
    - go vet ./...
    - go test ./... -v -count=1

release:
  stage: release
  image: golang:1.22
  tags:
    - danuri
  rules:
    - if: $CI_COMMIT_TAG =~ /^v\d+\.\d+\.\d+/
  variables:
    GIT_DEPTH: 0
    GORELEASER_VERSION: "2.9.0"
  before_script:
    - curl -sL "https://github.com/goreleaser/goreleaser/releases/download/v${GORELEASER_VERSION}/goreleaser_Linux_x86_64.tar.gz" | tar xz -C /usr/local/bin goreleaser
    - goreleaser --version
  script:
    - goreleaser release --clean
