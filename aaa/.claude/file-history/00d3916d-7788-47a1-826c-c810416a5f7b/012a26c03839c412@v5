stages:
  - test
  - release

test:
  stage: test
  image: golang:1.26
  tags:
    - danuri
  script:
    - go vet ./...
    - go test ./... -v -count=1

release:
  stage: release
  image: golang:1.26
  tags:
    - danuri
  rules:
    - if: $CI_COMMIT_TAG =~ /^v\d+\.\d+\.\d+/
  variables:
    GIT_DEPTH: 0
  before_script:
    - go install github.com/goreleaser/goreleaser/v2@latest
  script:
    - goreleaser release --clean
