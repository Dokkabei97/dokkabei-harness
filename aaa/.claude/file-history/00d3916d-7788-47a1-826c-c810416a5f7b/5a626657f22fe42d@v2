func formatDate(date string) (string, error) {
	t, err := time.Parse("2006-01-02", date)
	if err != nil {
		return "", fmt.Errorf("invalid date format %q, expected YYYY-MM-DD", date)
	}
	return t.Format(time.RFC3339), nil
}

// NewCmd creates the cycle command.
func NewCmd(f *cmdutil.Factory) *cobra.Command {
	cmd := &cobra.Command{
		Use:     "cycle",
		Aliases: []string{"cy"},
		Short:   "Manage cycles",
	}

	cmd.AddCommand(newListCmd(f))
	cmd.AddCommand(newGetCmd(f))
	cmd.AddCommand(newCreateCmd(f))
	cmd.AddCommand(newUpdateCmd(f))
	cmd.AddCommand(newDeleteCmd(f))
	cmd.AddCommand(newTransferCmd(f))
	cmd.AddCommand(newArchiveCmd(f))
	cmd.AddCommand(newUnarchiveCmd(f))

	return cmd
}

var cycleColumns = []output.Column{
	{Header: "ID", Field: "id"},
	{Header: "NAME", Field: "name"},
	{Header: "START_DATE", Field: "start_date"},
	{Header: "END_DATE", Field: "end_date"},
	{Header: "STATUS", Field: "status"},
}

func cyclePath() string {
	return "workspaces/{workspace_slug}/projects/{project_id}/cycles/"
}

func newListCmd(f *cmdutil.Factory) *cobra.Command {
	return &cobra.Command{
		Use:   "list",
		Short: "List all cycles in a project",
		RunE: func(cmd *cobra.Command, args []string) error {
			client, err := f.Client()
			if err != nil {
				return err
			}
			ws, proj, err := f.RequireWorkspaceAndProject()
			if err != nil {
				return err
			}

			path, err := api.NewPath(cyclePath()).
				Workspace(ws).Project(proj).Build()
			if err != nil {
				return err
			}

			resp, err := client.Get(path)
			if err != nil {
				return err
			}

			return output.FormatRaw(f.Format, resp, cycleColumns)
		},
	}
}

