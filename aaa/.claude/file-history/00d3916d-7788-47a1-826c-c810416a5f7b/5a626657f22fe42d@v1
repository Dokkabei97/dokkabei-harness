func newCreateCmd(f *cmdutil.Factory) *cobra.Command {
	var name, description, startDate, endDate string

	cmd := &cobra.Command{
		Use:   "create",
		Short: "Create a new cycle",
		RunE: func(cmd *cobra.Command, args []string) error {
			if name == "" {
				return fmt.Errorf("--name is required")
			}

			client, err := f.Client()
			if err != nil {
				return err
			}
			ws, proj, err := f.RequireWorkspaceAndProject()
			if err != nil {
				return err
			}

			path, err := api.NewPath(cyclePath()).
				Workspace(ws).Project(proj).Build()
			if err != nil {
				return err
			}

			body := map[string]interface{}{
				"name": name,
			}
			if description != "" {
				body["description"] = description
			}
			if startDate != "" {
				body["start_date"] = startDate
			}
			if endDate != "" {
				body["end_date"] = endDate
			}

			resp, err := client.Post(path, body)
			if err != nil {
				return err
			}

			return output.FormatRaw(f.Format, resp, cycleColumns)
		},
	}

	cmd.Flags().StringVar(&name, "name", "", "Cycle name (required)")
	cmd.Flags().StringVar(&description, "description", "", "Cycle description")
	cmd.Flags().StringVar(&startDate, "start-date", "", "Start date (YYYY-MM-DD)")
	cmd.Flags().StringVar(&endDate, "end-date", "", "End date (YYYY-MM-DD)")

	return cmd
}

func newUpdateCmd(f *cmdutil.Factory) *cobra.Command {
	var name, description, startDate, endDate string

	cmd := &cobra.Command{
		Use:   "update <cycle-id>",
		Short: "Update a cycle",
		Args:  cobra.ExactArgs(1),
		RunE: func(cmd *cobra.Command, args []string) error {
			client, err := f.Client()
			if err != nil {
				return err
			}
			ws, proj, err := f.RequireWorkspaceAndProject()
			if err != nil {
				return err
			}

			path, err := api.NewPath(cyclePath()+"{cycle_id}/").
				Workspace(ws).Project(proj).Param("cycle_id", args[0]).Build()
			if err != nil {
				return err
			}

			body := make(map[string]interface{})
			if cmd.Flags().Changed("name") {
				body["name"] = name
			}
			if cmd.Flags().Changed("description") {
				body["description"] = description
			}
			if cmd.Flags().Changed("start-date") {
				body["start_date"] = startDate
			}
			if cmd.Flags().Changed("end-date") {
				body["end_date"] = endDate
			}

			if len(body) == 0 {
				return fmt.Errorf("at least one field must be specified to update")
			}

			resp, err := client.Patch(path, body)
			if err != nil {
				return err
			}

			return output.FormatRaw(f.Format, resp, cycleColumns)
		},
	}

	cmd.Flags().StringVar(&name, "name", "", "Cycle name")
	cmd.Flags().StringVar(&description, "description", "", "Cycle description")
	cmd.Flags().StringVar(&startDate, "start-date", "", "Start date (YYYY-MM-DD)")
	cmd.Flags().StringVar(&endDate, "end-date", "", "End date (YYYY-MM-DD)")

	return cmd
}

