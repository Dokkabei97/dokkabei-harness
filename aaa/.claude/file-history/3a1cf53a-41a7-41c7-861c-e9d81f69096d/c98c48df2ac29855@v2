    ├── statusline-command.sh   # 상태 표시줄 스크립트
    ├── hooks/
    │   └── hooks.json          # 이벤트 훅 정의 (15개)
    └── output-styles/
        └── learning-plus.md    # 학습 중심 출력 스타일
```

