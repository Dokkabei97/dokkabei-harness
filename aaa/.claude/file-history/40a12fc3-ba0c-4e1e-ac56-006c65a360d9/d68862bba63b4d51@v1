import type {
  SearchDictionaryBackendDTO,
  SearchDictionaryCursorPage,
  SearchDictionaryCursorResponse,
  SearchDictionaryEntry,
} from '@/views/search-dictionary/model/types'

export const mapDictionaryResponse = (data: SearchDictionaryBackendDTO): SearchDictionaryEntry => ({
  id: data.id,
  type: data.type,
  keyword: data.keyword,
  value: data.value ?? '',
  createdAt: data.createdTime,
  updatedAt: data.updatedTime,
})

export const mapCursorDictionaryResponse = (
  data: SearchDictionaryCursorResponse,
): SearchDictionaryCursorPage<SearchDictionaryEntry> => ({
  items: data.items.map(mapDictionaryResponse),
  total: data.total,
  nextCursor: data.cursor,
  hasNext: data.hasNext,
})
