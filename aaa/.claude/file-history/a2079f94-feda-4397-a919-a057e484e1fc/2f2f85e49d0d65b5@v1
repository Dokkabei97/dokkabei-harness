---
eck-elasticsearch:
  enabled: true
  # Note. `-es` postfix가 자동으로 붙습니다.
  fullnameOverride: dev-cmn
  # Note. Stack Monitoring 활성화 - metricbeat/filebeat 사이드카 자동 주입
  # Self-monitoring: 자기 자신(dev-cmn)에게 모니터링 데이터 저장
  # 만약 운영 환경에서 별도의 모니터링 클러스터를 운영한다면, elasticsearchRefs에 해당 클러스터 이름을 넣어주세요.
  spec:
    monitoring:
      metrics:
        elasticsearchRefs:
          - name: dev-cmn
      logs:
        elasticsearchRefs:
          - name: dev-cmn
  nodeSets:
    # ═══════════════════════════════════════════════════════════════════════════
    # MASTER 노드 (3개)
    # ═══════════════════════════════════════════════════════════════════════════
    - name: master
      count: 3
      config:
        node.roles: [ "master" ]
      volumeClaimTemplates:
        - metadata:
            name: elasticsearch-data  # 데이터 경로에 대한 볼륨 마운트를 설정하지 않는 한 이 이름을 변경하지 마세요.
          spec:
            accessModes:
              - ReadWriteOnce
            resources:
              requests:
                storage: 5Gi
      podTemplate:
        spec:
          initContainers:
            - name: sysctl
              securityContext:
                privileged: true
                runAsUser: 0
              command: [ 'sh', '-c', 'sysctl -w vm.max_map_count=262144' ]
          containers:
            - name: elasticsearch
              image: harbor.cowave.kr/search/elasticsearch:9.1.2-ad-1.0.0
              imagePullPolicy: Always
              env:
                - name: ES_JAVA_OPTS
                  value: "-Xms8g -Xmx8g"
              resources:
                limits:
                  memory: 10Gi
                  cpu: 4
                requests:
                  memory: 10Gi
                  cpu: 4
          # Note. 형태소 분석기 사전 마운트
          # 형태소 분석기 플러그인이 설치된 경로에 사전 파일들을 마운트합니다.
          # NFS 또는 공유 PVC를 사용하여 모든 노드에서 동일한 사전 파일을 참조할 수 있도록 설정해야 합니다.
              volumeMounts:
                - name: dictionary-volume
                  mountPath: /usr/share/elasticsearch/plugins/analysis-danuri/dict
                  readOnly: true
          volumes:
            - name: dictionary-volume
              persistentVolumeClaim:
                claimName: search-dictionary-shared-pvc
          imagePullSecrets:
            - name: search-harbor-cowave-secret
    - name: data
      count: 3
      config:
        node.roles: [ "data", "ingest" ]
      volumeClaimTemplates:
        - metadata:
            name: elasticsearch-data  # 데이터 경로에 대한 볼륨 마운트를 설정하지 않는 한 이 이름을 변경하지 마세요.
          spec:
            accessModes:
              - ReadWriteOnce
            resources:
              requests:
                storage: 150Gi
      podTemplate:
        spec:
          initContainers:
            - name: sysctl
              securityContext:
                privileged: true
                runAsUser: 0
              command: [ 'sh', '-c', 'sysctl -w vm.max_map_count=262144' ]
          containers:
            - name: elasticsearch
              image: harbor.cowave.kr/search/elasticsearch:9.1.2-ad-1.0.0
              imagePullPolicy: Always
              env:
                - name: ES_JAVA_OPTS
                  value: "-Xms10g -Xmx10g"
              resources:
                limits:
                  memory: 12Gi
                  cpu: 4
                requests:
                  memory: 12Gi
                  cpu: 4
              volumeMounts:
                - name: dictionary-volume
                  mountPath: /usr/share/elasticsearch/plugins/analysis-danuri/dict
                  readOnly: true
          volumes:
            - name: dictionary-volume
              persistentVolumeClaim:
                claimName: search-dictionary-shared-pvc
          imagePullSecrets:
            - name: search-harbor-cowave-secret
  ingress:
    enabled: true
    className: nginx
    annotations:
      nginx.ingress.kubernetes.io/proxy-body-size: "50m"
    pathType: Prefix
    hosts:
      - host: dev-cmn-elasticsearch.danuricorp.com
        path: /
        service: dev-cmn-es-master
        port: 9200
      - host: dev-cmn-keyword-analysis-api.danuricorp.com
        path: /
        service: dev-cmn-es-data
        port: 9200
  httpRoute:
    enabled: false
    parentRefs:
      - name: istio-cmn-dev-gateway
        namespace: istio-system
    hosts:
      - name: elasticsearch
        hostname: dev-cmn-elasticsearch.danuricorp.com
        service: dev-cmn-es-master
        port: 9200
      - name: keyword-analysis
        hostname: dev-cmn-keyword-analysis-api.danuricorp.com
        service: dev-cmn-es-data
        port: 9200

eck-kibana:
  enabled: true
  # Note. `-kb` postfix가 자동으로 붙습니다.
  fullnameOverride: dev-cmn
  elasticsearchRef:
    name: dev-cmn
    serviceName: dev-cmn-es-data # 형태소 분석기 떄문에 kibana가 데이터 노드에만 붙게 수정
  config:
    # Stack Monitoring UI 사용을 위한 설정
    # 기본값 true일 경우, 별도의 원격 모니터링 클러스터에서 데이터를 조회하려고 시도함
    # Self-monitoring(자기 자신을 모니터링)할 때는 false로 설정 필요
    monitoring.ui.ccs.enabled: false
  ingress:
    enabled: true
    className: nginx
    pathType: Prefix
    hosts:
      - host: dev-cmn-kibana.danuricorp.com
        path: /
    tls:
      enabled: true
      secretName: dev-tls
  httpRoute:
    enabled: false
    parentRefs:
      - name: istio-cmn-dev-gateway
        namespace: istio-system
    hostnames:
      - dev-cmn-kibana.danuricorp.com
    rules:
      - matches:
          - path:
              type: PathPrefix
              value: /
