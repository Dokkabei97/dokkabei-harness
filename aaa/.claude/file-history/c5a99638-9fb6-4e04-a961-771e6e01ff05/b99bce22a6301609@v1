## 검증
```bash
BASE="/Users/admin/Documents/Obsidian Vault/📚학습노트/LLM-RAG"

# 1. 전체 구조 확인
ls -R "$BASE"

# 2. 루트에 .md 잔존 확인 (없어야 함)
find "$BASE" -maxdepth 1 -name "*.md" | head -5

# 3. 총 파일 수 확인 (41개여야 함)
find "$BASE" -name "*.md" | wc -l

# 4. 각 챕터별 파일 수 확인
for dir in "$BASE"/*/; do
  count=$(find "$dir" -name "*.md" | wc -l | tr -d ' ')
  echo "$(basename "$dir"): ${count}개"
done
# 기대: 1장(7), 2장(9), 3장(8), 4장(7), 5장(10)
```

