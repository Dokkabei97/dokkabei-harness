package com.cowave.search.domain.index.dto

import java.time.Instant

data class LegacyProductData(
    override val id: String,
    override val name: String,
    val shopId: Int,
    val mallProductId: String,
    val mallProductCompositedId: String?,
    val categoryId: Int,
    val mallCategory: String?,
    val mallCategoryId: Long?,
    val mallBrandName: String?,
    val brandId: Long?,
    val mallManufacturerName: String?,
    val manufacturerId: Long?,
    val manufactureDefineNumber: String?,
    val imageUrl: String?,
    val hasStock: Boolean,
    val productStatus: String,
    val isCatalogMatch: Boolean,
    val isUsedProduct: Boolean,
    val isRefurbished: Boolean,
    val isImportProduct: Boolean?,
    val hasInstallationCosts: Boolean?,
    val barcode: String?,
    val sellerId: String?,
    val reviewCount: Int?,
    val vendorId: String?,
    val additionalInfo: String?,
    val collectedAt: Instant,
    val updatedAt: Instant,
    val createdAt: Instant?,
    val linkUrl: LegacyUrl?,
    val price: LegacyPrice?,
    val delivery: LegacyDelivery?,
    val isbn: String?,
    val isAdultRequired: Boolean?,
    val isBrandCertification: Boolean,
    val benefit: LegacyBenefit?,
    val promotions: List<LegacyPromotion>?,
    val eventInfo: String?,
    val unreceivedAt: Instant?,
) : ChangedDocument {
    data class LegacyUrl(
        val pc: String?,
        val mobile: String?,
    )

    data class LegacyPrice(
        val pc: Long?,
        val mobile: Long?,
        val membershipPrice: Long?,
    )

    data class LegacyDelivery(
        val shipping: Int?,
        val originalShipping: Int?,
        val isConditionalShipping: Boolean?,
        val hasShippingGrade: Boolean?,
        val shippingGradeInfo: String?,
        val info: String?,
        val fastDeliveryTime: Int?,
    )

    data class LegacyBenefit(
        val point: Int?,
        val coupon: String?,
        val interestFree: String?,
        val gift: String?,
        val hasCouponDownload: Boolean?,
    )

    data class LegacyPromotion(
        val type: Int?,
        val name: String?,
        val price: Long?,
    )
}
