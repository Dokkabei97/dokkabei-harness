image:
  pullPolicy: Always
  tag: "latest"

nameOverride: "cmn-legacy-sync"
fullnameOverride: "cmn-legacy-sync"
otelServiceName: "backend-was.cmn-search.cmn-legacy-sync"

envFrom:
  # 공통 ConfigMap 참조
  - configMapRef:
      name: cmn-search-config
  # 서비스 특화 ConfigMap 참조
  - configMapRef:
      name: cmn-legacy-sync-config
  # secret 참조
  - secretRef:
      name: "cmn-search-credentials"

# 서비스 특화 ConfigMap 설정
config:
  index:
    adminCatalog: catalogs
    adminProduct: products

ingress:
  enabled: true
  className: "nginx"
  annotations: { }
  hosts:
    - host: cmn-legacy-sync.danuricorp.com
      paths:
        - path: /
          pathType: Prefix
          port: 8080
  tls: [ ]

resources:
  limits:
    memory: 4Gi
    cpu: 2
  requests:
    memory: 2Gi
    cpu: 2

replicaCount: 2

autoscaling:
  enabled: true
  minReplicas: 2
  maxReplicas: 5
  targetCPUUtilizationPercentage: 80

podAnnotations:
  grafana.danuricorp.com/app: backend-was.cmn-search.cmn-legacy-sync
  prometheus.io/interval: 30s
