package com.cowave.search.outbound_adapter.legacy

import com.cowave.search.application.index.dto.LinkedProductRequest
import com.cowave.search.application.index.dto.UnlinkedProductDeleteRequest
import com.cowave.search.application.index.dto.UnlinkedProductRequest
import com.cowave.search.application.index.repository.LegacyReserveSyncRepository
import com.cowave.search.client.legacy_api.LegacyApiClient
import com.cowave.search.domain.index.enums.Operation
import com.cowave.shared.utils.logger
import org.springframework.http.HttpMethod
import org.springframework.stereotype.Component

@Component
class LegacyReserveSyncRepositoryImpl(
    private val legacyApiClient: LegacyApiClient,
) : LegacyReserveSyncRepository {
    private val logger by logger()

    override suspend fun pushLinkedProducts(
        products: List<LinkedProductRequest>,
        operation: Operation,
    ) {
        logger.info { "레거시 연동상품 동기화 요청 [operation=$operation, count=${products.size}]" }
        legacyApiClient.pushQueue(service = "PDM", method = operation.toHttpMethod(), body = products)
    }

    override suspend fun pushUnlinkedProducts(
        products: List<UnlinkedProductRequest>,
        operation: Operation,
    ) {
        logger.info { "레거시 비연동상품 동기화 요청 [operation=$operation, count=${products.size}]" }
        legacyApiClient.pushQueue(service = "TCMPNY_LINK", method = operation.toHttpMethod(), body = products)
    }

    override suspend fun pushUnlinkedProductDeletes(products: List<UnlinkedProductDeleteRequest>) {
        logger.info { "레거시 비연동상품 삭제 동기화 요청 [count=${products.size}]" }
        legacyApiClient.pushQueue(service = "TCMPNY_LINK", method = HttpMethod.DELETE, body = products)
    }

    private fun Operation.toHttpMethod(): HttpMethod =
        when (this) {
            Operation.CREATE -> HttpMethod.POST
            Operation.UPDATE -> HttpMethod.PUT
            Operation.DELETE -> HttpMethod.DELETE
        }
}
