image:
  pullPolicy: Always
  tag: "latest"

nameOverride: "dev-cmn-legacy-sync"
fullnameOverride: "dev-cmn-legacy-sync"
otelServiceName: "development.dev-search.dev-cmn-legacy-sync"

envFrom:
  # 서비스 특화 ConfigMap 참조
  - configMapRef:
      name: dev-cmn-legacy-sync-config
  # secret 참조
  - secretRef:
      name: "dev-cmn-search-credentials"

# 서비스 특화 ConfigMap 설정
config:
  profile: dev
  index:
    adminCatalog: catalogs
    adminProduct: products
  # 인프라 공통 설정 (shared-resources에서 이관)
  elasticsearch:
    urls: "http://dev-cmn-es-http:9200"
    connectionTimeout: "5000"
    socketTimeout: "5000"
  valkey:
    backend:
      host: "dev-cmn-infra-valkey-cluster-headless.cmn-infra.svc.cluster.local"
      port: "6379"
      database: "0"
      maxConnection: "10"
      clusterMode: "true"
  keywordAnalysis:
    url: "http://dev-cmn-es-data:9200"
    connectionTimeout: "5000"
    socketTimeout: "5000"

ingress:
  enabled: true
  className: "nginx"
  annotations: { }
  hosts:
    - host: dev-cmn-legacy-sync.danuricorp.com
      paths:
        - path: /
          pathType: Prefix
          port: 8080
  tls: [ ]

resources:
  limits:
    memory: 2Gi
    cpu: 1
  requests:
    memory: 1Gi
    cpu: 1

replicaCount: 1

autoscaling:
  enabled: false

podAnnotations:
  grafana.danuricorp.com/app: development.dev-search.dev-cmn-legacy-sync
  prometheus.io/interval: 30s
