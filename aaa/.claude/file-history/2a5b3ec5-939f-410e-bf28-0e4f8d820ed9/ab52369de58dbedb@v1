apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ include "dynamic-indexer.fullname" . }}-config
  labels:
    {{- include "dynamic-indexer.labels" . | nindent 4 }}
data:
  OTEL_SERVICE_NAME: {{ .Values.otelServiceName | quote }}
  OTEL_EXPORTER_OTLP_ENDPOINT: {{ .Values.otel.endpoint | quote }}
  OTEL_TRACES_EXPORTER: {{ .Values.otel.tracesExporter | quote }}
  OTEL_METRICS_EXPORTER: {{ .Values.otel.metricsExporter | quote }}
  OTEL_LOGS_EXPORTER: {{ .Values.otel.logsExporter | quote }}
  OTEL_INSTRUMENTATION_MICROMETER_ENABLED: {{ .Values.otel.micrometerEnabled | quote }}
  JAVA_TOOL_OPTIONS: >
    -javaagent:{{ .Values.otel.agentPath }}
    -Dotel.experimental.config.file={{ .Values.otel.otelConfig }}

  # Spring Boot profile
  SPRING_PROFILES_ACTIVE: {{ .Values.config.profile | quote }}

  # Index configuration
  SEARCH_INDEX_ADMIN_CATALOG: {{ .Values.config.index.adminCatalog | quote }}
  SEARCH_INDEX_ADMIN_PRODUCT: {{ .Values.config.index.adminProduct | quote }}
  SEARCH_INDEX_APP_PRODUCT: {{ .Values.config.index.appProduct | quote }}
  SEARCH_INDEX_APP_CATALOG: {{ .Values.config.index.appCatalog | quote }}

  KEYWORD_ANALYSIS_URL: {{ .Values.config.keywordAnalysis.url | quote }}
  KEYWORD_ANALYSIS_CONNECTION_TIMEOUT: {{ .Values.config.keywordAnalysis.connectionTimeout | quote }}
  KEYWORD_ANALYSIS_SOCKET_TIMEOUT: {{ .Values.config.keywordAnalysis.socketTimeout | quote }}

  # Catalog CDC configuration
  KAFKA_CDC_CATALOG_SERVER: "{{ .Values.config.kafka.catalogCdc.bootstrapServers }}"
  KAFKA_CDC_CATALOG_TOPIC: "{{.Values.config.kafka.catalogCdc.topic}}"
  KAFKA_CDC_CATALOG_GROUP_ID: "{{.Values.config.kafka.catalogCdc.groupId}}"
  KAFKA_CDC_CATALOG_CONCURRENCY: "{{.Values.config.kafka.catalogCdc.concurrency}}"
  KAFKA_CDC_CATALOG_PROP_AUTO_OFFSET_RESET: "{{.Values.config.kafka.catalogCdc.properties.autoOffsetReset}}"
  KAFKA_CDC_CATALOG_PROP_ENABLE_AUTO_COMMIT: "{{.Values.config.kafka.catalogCdc.properties.enableAutoCommit}}"
  KAFKA_CDC_CATALOG_PROP_MAX_POLL_RECORDS: "{{.Values.config.kafka.catalogCdc.properties.maxPollRecords}}"
  KAFKA_CDC_CATALOG_PROP_FETCH_MAX_WAIT_MS: "{{.Values.config.kafka.catalogCdc.properties.fetchMaxWaitMs}}"
  KAFKA_CDC_CATALOG_PROP_FETCH_MIN_SIZE: "{{.Values.config.kafka.catalogCdc.properties.fetchMinSize}}"
  KAFKA_CDC_CATALOG_PROP_SESSION_TIMEOUT_MS: "{{.Values.config.kafka.catalogCdc.properties.sessionTimeoutMs}}"
  KAFKA_CDC_CATALOG_PROP_SCHEMA_REGISTRY_URL: "{{.Values.config.kafka.catalogCdc.properties.schemaRegistryUrl}}"
  KAFKA_CDC_CATALOG_PROP_SPECIFIC_AVRO_READER: "{{.Values.config.kafka.catalogCdc.properties.specificAvroReader}}"
  KAFKA_CDC_CATALOG_PROP_HEARTBEAT_INTERVAL_MS: "{{.Values.config.kafka.catalogCdc.properties.heartbeatIntervalMs}}"
  KAFKA_CDC_CATALOG_PROP_SECURITY_PROTOCOL: {{.Values.config.kafka.catalogCdc.properties.securityProtocol}}
  KAFKA_CDC_CATALOG_PROP_SASL_MECHANISM: {{.Values.config.kafka.catalogCdc.properties.saslMechanism}}

  # Product CDC configuration
  KAFKA_CDC_PRODUCT_SERVER: "{{ .Values.config.kafka.productCdc.bootstrapServers }}"
  KAFKA_CDC_PRODUCT_TOPIC: "{{.Values.config.kafka.productCdc.topic}}"
  KAFKA_CDC_PRODUCT_GROUP_ID: "{{.Values.config.kafka.productCdc.groupId}}"
  KAFKA_CDC_PRODUCT_CONCURRENCY: "{{.Values.config.kafka.productCdc.concurrency}}"
  KAFKA_CDC_PRODUCT_PROP_AUTO_OFFSET_RESET: "{{.Values.config.kafka.productCdc.properties.autoOffsetReset}}"
  KAFKA_CDC_PRODUCT_PROP_ENABLE_AUTO_COMMIT: "{{.Values.config.kafka.productCdc.properties.enableAutoCommit}}"
  KAFKA_CDC_PRODUCT_PROP_MAX_POLL_RECORDS: "{{.Values.config.kafka.productCdc.properties.maxPollRecords}}"
  KAFKA_CDC_PRODUCT_PROP_FETCH_MAX_WAIT_MS: "{{.Values.config.kafka.productCdc.properties.fetchMaxWaitMs}}"
  KAFKA_CDC_PRODUCT_PROP_FETCH_MIN_SIZE: "{{.Values.config.kafka.productCdc.properties.fetchMinSize}}"
  KAFKA_CDC_PRODUCT_PROP_SESSION_TIMEOUT_MS: "{{.Values.config.kafka.productCdc.properties.sessionTimeoutMs}}"
  KAFKA_CDC_PRODUCT_PROP_SCHEMA_REGISTRY_URL: "{{.Values.config.kafka.productCdc.properties.schemaRegistryUrl}}"
  KAFKA_CDC_PRODUCT_PROP_SPECIFIC_AVRO_READER: "{{.Values.config.kafka.productCdc.properties.specificAvroReader}}"
  KAFKA_CDC_PRODUCT_PROP_HEARTBEAT_INTERVAL_MS: "{{.Values.config.kafka.productCdc.properties.heartbeatIntervalMs}}"
  KAFKA_CDC_PRODUCT_PROP_SECURITY_PROTOCOL: {{.Values.config.kafka.productCdc.properties.securityProtocol}}
  KAFKA_CDC_PRODUCT_PROP_SASL_MECHANISM: {{.Values.config.kafka.productCdc.properties.saslMechanism}}


  # Indexer Admin configuration
  KAFKA_INDEXER_ADMIN_SERVER: "{{ .Values.config.kafka.indexerAdmin.bootstrapServers }}"
  KAFKA_INDEXER_ADMIN_TOPIC: "{{.Values.config.kafka.indexerAdmin.topic}}"
  KAFKA_INDEXER_ADMIN_GROUP_ID: "{{.Values.config.kafka.indexerAdmin.groupId}}"
  KAFKA_INDEXER_ADMIN_CONCURRENCY: "{{.Values.config.kafka.indexerAdmin.concurrency}}"
  KAFKA_INDEXER_ADMIN_PROP_AUTO_OFFSET_RESET: "{{.Values.config.kafka.indexerAdmin.properties.autoOffsetReset}}"
  KAFKA_INDEXER_ADMIN_PROP_ENABLE_AUTO_COMMIT: "{{.Values.config.kafka.indexerAdmin.properties.enableAutoCommit}}"
  KAFKA_INDEXER_ADMIN_PROP_SECURITY_PROTOCOL: {{.Values.config.kafka.indexerAdmin.properties.securityProtocol}}
  KAFKA_INDEXER_ADMIN_PROP_SASL_MECHANISM: {{.Values.config.kafka.indexerAdmin.properties.saslMechanism}}

  # Proxy API configuration
  PROXY_API_BASEURL: "{{.Values.config.client.proxyApi.baseUrl}}"