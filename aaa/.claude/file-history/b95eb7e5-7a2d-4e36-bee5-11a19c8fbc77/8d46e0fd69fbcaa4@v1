// middleware.ts
import { NextRequest, NextResponse } from 'next/server'
import {
    MOCK_ENABLED,
    GRAPHQL_ENDPOINT,
    isUnauthorizedPostRequest,
    handleMockTokens,
    validateTokens,
    extractTokens,
    checkPermission
} from '@/shared/services/middleware'

export async function middleware(req: NextRequest) {
    // 1) Mock 서버 모드면 mock 토큰 설정 후 통과
    if (MOCK_ENABLED) {
        return handleMockTokens(req)
    }

    // 2) unauthorized 페이지로의 POST 요청 차단
    if (isUnauthorizedPostRequest(req.nextUrl.pathname, req.method)) {
        return new NextResponse('Method Not Allowed', { status: 405 })
    }

    // 3) 토큰 검증 (access_token, refresh_token)
    const tokenValidationResult = validateTokens(req)
    if (tokenValidationResult) {
        return tokenValidationResult
    }

    // 4) 권한 체크 (도메인·경로 기반)
    try {
        const { access_token } = extractTokens(req)
        return await checkPermission(req, access_token, GRAPHQL_ENDPOINT)
    } catch (error) {
        // 토큰 추출 실패 시 로그인 페이지로 리다이렉트
        console.error('Token extraction failed:', error)
        return NextResponse.redirect(new URL('/login', req.url))
    }
}

export const config = {
    matcher: [
        /*
         * Match all request paths except for the ones starting with:
         * - api (API routes)
         * - _next/static (static files)
         * - _next/image (image optimization files)
         * - favicon.ico (favicon file)
         * - .well-known (browser auto-requests)
         * - AUTH (GraphQL proxy endpoint)
         */
        '/((?!api|billing-api|_next/static|_next/image|favicon.ico|\\.well-known|login|unauthorized|error|auth|popup|AUTH|SHOPPING|AI_ATTRIBUTE).*)'
    ]
}
