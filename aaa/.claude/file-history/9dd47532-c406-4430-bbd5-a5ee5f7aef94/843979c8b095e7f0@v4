# Auto Agents MCP - 모델 설정
# 새 모델 추가/변경 시 이 파일만 수정하면 됩니다

agents:
  claude:
    default: claude-opus-4.6
    models:
      - claude-opus-4.6
      - claude-sonnet-4.5
      - claude-haiku-4.5

  codex:
    default: gpt-5.3-codex-spark
    defaultAnalysisLevel: xhigh
    models:
      - gpt-5.3-codex-spark
      - gpt-5.3-codex
      - gpt-5.2-codex-max
      - gpt-5.2-codex

  gemini:
    default: gemini-3-pro-preview
    models:
      - gemini-3-pro-preview
      - gemini-3-flash-preview
      - gemini-2.5-pro
      - gemini-2.5-flash

  copilot:
    default: claude-sonnet-4.5
    models:
#      - claude-opus-4.6
      - claude-opus-4.5
      - claude-sonnet-4.5
      - claude-haiku-4.5
#      - gpt-5.3-codex
      - gpt-5.2-codex
      - gemini-3-pro-preview
      - gemini-3-flash-preview
