BINARY_NAME=plane
VERSION?=$(shell git describe --tags --always --dirty 2>/dev/null || echo "dev")
COMMIT?=$(shell git rev-parse --short HEAD 2>/dev/null || echo "unknown")
BUILD_DATE?=$(shell date -u +"%Y-%m-%dT%H:%M:%SZ")
LDFLAGS=-ldflags "-X github.com/plane-cli/plane-cli/cmd.Version=$(VERSION) -X github.com/plane-cli/plane-cli/cmd.Commit=$(COMMIT) -X github.com/plane-cli/plane-cli/cmd.BuildDate=$(BUILD_DATE)"

.PHONY: build test clean install lint fmt vet

build:
	go build $(LDFLAGS) -o $(BINARY_NAME) .

install:
	go install $(LDFLAGS) .

test:
	go test ./... -v -count=1

test-cover:
	go test ./... -coverprofile=coverage.out
	go tool cover -html=coverage.out -o coverage.html

clean:
	rm -f $(BINARY_NAME)
	rm -f coverage.out coverage.html

fmt:
	go fmt ./...

vet:
	go vet ./...

lint: fmt vet

all: lint test build
