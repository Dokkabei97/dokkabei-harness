package models

// Worklog represents a time tracking entry.
type Worklog struct {
	ID          string  `json:"id"`
	Description string  `json:"description,omitempty"`
	Duration    float64 `json:"duration"`
	LoggedAt    string  `json:"logged_at,omitempty"`
	WorkItem    string  `json:"work_item"`
	Project     string  `json:"project"`
	Workspace   string  `json:"workspace"`
	CreatedBy   string  `json:"created_by"`
	Timestamps
}

// CreateWorklogRequest is the request body for creating a worklog.
type CreateWorklogRequest struct {
	Description string  `json:"description,omitempty"`
	Duration    float64 `json:"duration"`
	LoggedAt    string  `json:"logged_at,omitempty"`
}

// UpdateWorklogRequest is the request body for updating a worklog.
type UpdateWorklogRequest struct {
	Description *string  `json:"description,omitempty"`
	Duration    *float64 `json:"duration,omitempty"`
}

// WorklogTotal represents total time logged.
type WorklogTotal struct {
	Total    float64 `json:"total"`
	Duration float64 `json:"duration"`
}
