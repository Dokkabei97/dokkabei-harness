func newCreateCmd(f *cmdutil.Factory) *cobra.Command {
	var issue, body string

	cmd := &cobra.Command{
		Use:   "create",
		Short: "Create a new comment",
		RunE: func(cmd *cobra.Command, args []string) error {
			if issue == "" {
				return fmt.Errorf("--issue is required")
			}
			if body == "" {
				return fmt.Errorf("--body is required")
			}

			issueID, err := f.ResolveIssueID(issue)
			if err != nil {
				return err
			}

			client, err := f.Client()
			if err != nil {
				return err
			}
			ws, proj, err := f.RequireWorkspaceAndProject()
			if err != nil {
				return err
			}

			path, err := api.NewPath(commentPath()).
				Workspace(ws).Project(proj).Param("issue_id", issueID).Build()
			if err != nil {
				return err
			}

			payload := map[string]interface{}{
				"comment_html": wrapHTML(body),
			}

			resp, err := client.Post(path, payload)
			if err != nil {
				return err
			}

			resp = output.InjectField(resp, "issue_ref", issue)
			return output.FormatRaw(f.Format, resp, commentColumns)
		},
	}

	cmd.Flags().StringVar(&issue, "issue", "", "Work item ID or identifier like PROJ-123 (required)")
	cmd.Flags().StringVar(&body, "body", "", "Comment body (HTML, required)")

	return cmd
}

func newUpdateCmd(f *cmdutil.Factory) *cobra.Command {
	var issue, body string

	cmd := &cobra.Command{
		Use:   "update <comment-id>",
		Short: "Update a comment",
		Args:  cobra.ExactArgs(1),
		RunE: func(cmd *cobra.Command, args []string) error {
			if issue == "" {
				return fmt.Errorf("--issue is required")
			}

			issueID, err := f.ResolveIssueID(issue)
			if err != nil {
				return err
			}

			client, err := f.Client()
			if err != nil {
				return err
			}
			ws, proj, err := f.RequireWorkspaceAndProject()
			if err != nil {
				return err
			}

			path, err := api.NewPath(commentPath()+"{comment_id}/").
				Workspace(ws).Project(proj).Param("issue_id", issueID).
				Param("comment_id", args[0]).Build()
			if err != nil {
				return err
			}

			payload := make(map[string]interface{})
			if cmd.Flags().Changed("body") {
				payload["comment_html"] = wrapHTML(body)
			}

			if len(payload) == 0 {
				return fmt.Errorf("at least one field must be specified to update")
			}

			resp, err := client.Patch(path, payload)
			if err != nil {
				return err
			}

			resp = output.InjectField(resp, "issue_ref", issue)
			return output.FormatRaw(f.Format, resp, commentColumns)
		},
	}

	cmd.Flags().StringVar(&issue, "issue", "", "Work item ID or identifier like PROJ-123 (required)")
	cmd.Flags().StringVar(&body, "body", "", "Comment body (HTML)")

	return cmd
}

func newDeleteCmd(f *cmdutil.Factory) *cobra.Command {
	var issue string

	cmd := &cobra.Command{
		Use:   "delete <comment-id>",
		Short: "Delete a comment",
		Args:  cobra.ExactArgs(1),
		RunE: func(cmd *cobra.Command, args []string) error {
			if issue == "" {
				return fmt.Errorf("--issue is required")
			}

			issueID, err := f.ResolveIssueID(issue)
			if err != nil {
				return err
			}

			client, err := f.Client()
			if err != nil {
				return err
			}
			ws, proj, err := f.RequireWorkspaceAndProject()
			if err != nil {
				return err
			}

			path, err := api.NewPath(commentPath()+"{comment_id}/").
				Workspace(ws).Project(proj).Param("issue_id", issueID).
				Param("comment_id", args[0]).Build()
			if err != nil {
				return err
			}

			_, err = client.Delete(path)
