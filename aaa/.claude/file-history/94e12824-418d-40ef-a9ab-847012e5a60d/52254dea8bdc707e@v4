package comment

import (
	"fmt"
	"strings"

	"github.com/spf13/cobra"

	"github.com/plane-cli/plane-cli/internal/api"
	"github.com/plane-cli/plane-cli/internal/cmdutil"
	"github.com/plane-cli/plane-cli/internal/output"
)

// wrapHTML ensures text is wrapped in <p> tags for Plane's Tiptap editor.
// If the input already contains HTML tags, it's returned as-is.
func wrapHTML(s string) string {
	trimmed := strings.TrimSpace(s)
	if strings.HasPrefix(trimmed, "<") {
		return trimmed
	}
	return "<p>" + trimmed + "</p>"
}

// NewCmd creates the comment command.
func NewCmd(f *cmdutil.Factory) *cobra.Command {
	cmd := &cobra.Command{
		Use:   "comment",
		Short: "Manage issue comments",
	}

	cmd.AddCommand(newListCmd(f))
	cmd.AddCommand(newGetCmd(f))
	cmd.AddCommand(newCreateCmd(f))
	cmd.AddCommand(newUpdateCmd(f))
	cmd.AddCommand(newDeleteCmd(f))

	return cmd
}

var commentColumns = []output.Column{
	{Header: "ID", Field: "id"},
	{Header: "ISSUE", Field: "issue_ref"},
	{Header: "ACTOR", Field: "actor"},
	{Header: "BODY", Field: "comment_html"},
}

func commentPath() string {
	return "workspaces/{workspace_slug}/projects/{project_id}/work-items/{issue_id}/comments/"
}

func newListCmd(f *cmdutil.Factory) *cobra.Command {
	var issue string

	cmd := &cobra.Command{
		Use:   "list",
		Short: "List comments for an issue",
		RunE: func(cmd *cobra.Command, args []string) error {
			if issue == "" {
				return fmt.Errorf("--issue is required")
			}

			issueID, err := f.ResolveIssueID(issue)
			if err != nil {
				return err
			}

			client, err := f.Client()
			if err != nil {
				return err
			}
			ws, proj, err := f.RequireWorkspaceAndProject()
			if err != nil {
				return err
			}

			path, err := api.NewPath(commentPath()).
				Workspace(ws).Project(proj).Param("issue_id", issueID).Build()
			if err != nil {
				return err
			}

			resp, err := client.Get(path)
			if err != nil {
				return err
			}

			resp = output.InjectField(resp, "issue_ref", issue)
			return output.FormatRaw(f.Format, resp, commentColumns)
		},
	}

	cmd.Flags().StringVar(&issue, "issue", "", "Work item ID or identifier like PROJ-123 (required)")

	return cmd
}

