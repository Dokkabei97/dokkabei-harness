func newSearchCmd(f *cmdutil.Factory) *cobra.Command {
	var query string

	cmd := &cobra.Command{
		Use:   "search",
		Short: "Search issues",
		RunE: func(cmd *cobra.Command, args []string) error {
			if query == "" {
				return fmt.Errorf("--query is required")
			}

			client, err := f.Client()
			if err != nil {
				return err
			}
			ws, proj, err := f.RequireWorkspaceAndProject()
			if err != nil {
				return err
			}

			path, err := api.NewPath("workspaces/{workspace_slug}/projects/{project_id}/search/").
				Workspace(ws).Project(proj).Query("search", query).Build()
			if err != nil {
				return err
			}

			resp, err := client.Get(path)
			if err != nil {
				return err
			}

			return output.FormatRaw(f.Format, resp, issueColumns)
		},
	}

	cmd.Flags().StringVar(&query, "query", "", "Search query (required)")

	return cmd
}

func newCreateCmd(f *cmdutil.Factory) *cobra.Command {
	var name, description, state, priority, parent string
	var assignees, labels []string
	var startDate, targetDate string

	cmd := &cobra.Command{
		Use:   "create",
		Short: "Create a new issue",
		RunE: func(cmd *cobra.Command, args []string) error {
			if name == "" {
				return fmt.Errorf("--name is required")
			}

			client, err := f.Client()
			if err != nil {
				return err
			}
			ws, proj, err := f.RequireWorkspaceAndProject()
			if err != nil {
				return err
			}

			path, err := api.NewPath(workItemPath()).
				Workspace(ws).Project(proj).Build()
			if err != nil {
				return err
			}

			body := map[string]interface{}{
				"name": name,
			}
			if description != "" {
				body["description_html"] = description
			}
			if state != "" {
				body["state"] = state
			}
			if priority != "" {
				body["priority"] = priority
			}
			if parent != "" {
				body["parent"] = parent
			}
			if len(assignees) > 0 {
				body["assignees"] = assignees
			}
			if len(labels) > 0 {
				body["labels"] = labels
			}
			if startDate != "" {
				body["start_date"] = startDate
			}
			if targetDate != "" {
				body["target_date"] = targetDate
			}

			resp, err := client.Post(path, body)
			if err != nil {
				return err
			}

			return output.FormatRaw(f.Format, resp, issueColumns)
		},
	}

	cmd.Flags().StringVar(&name, "name", "", "Issue name (required)")
	cmd.Flags().StringVar(&description, "description", "", "Issue description (HTML)")
	cmd.Flags().StringVar(&state, "state", "", "State ID")
	cmd.Flags().StringVar(&priority, "priority", "", "Priority: urgent, high, medium, low, none")
	cmd.Flags().StringVar(&parent, "parent", "", "Parent issue ID")
	cmd.Flags().StringSliceVar(&assignees, "assignee", nil, "Assignee user IDs (comma-separated or repeated)")
	cmd.Flags().StringSliceVar(&labels, "label", nil, "Label IDs (comma-separated or repeated)")
	cmd.Flags().StringVar(&startDate, "start-date", "", "Start date (YYYY-MM-DD)")
	cmd.Flags().StringVar(&targetDate, "target-date", "", "Target date (YYYY-MM-DD)")

	return cmd
}

func newUpdateCmd(f *cmdutil.Factory) *cobra.Command {
	var name, description, state, priority string
	var assignees, labels []string

	cmd := &cobra.Command{
		Use:   "update <issue-id>",
		Short: "Update an issue",
		Args:  cobra.ExactArgs(1),
		RunE: func(cmd *cobra.Command, args []string) error {
			client, err := f.Client()
			if err != nil {
				return err
			}
			ws, proj, err := f.RequireWorkspaceAndProject()
			if err != nil {
				return err
			}

			path, err := api.NewPath(workItemPath()+"{issue_id}/").
				Workspace(ws).Project(proj).Param("issue_id", args[0]).Build()
			if err != nil {
				return err
			}

			body := make(map[string]interface{})
			if cmd.Flags().Changed("name") {
				body["name"] = name
			}
			if cmd.Flags().Changed("description") {
				body["description_html"] = description
			}
			if cmd.Flags().Changed("state") {
				body["state"] = state
			}
			if cmd.Flags().Changed("priority") {
				body["priority"] = priority
			}
			if cmd.Flags().Changed("assignee") {
				body["assignees"] = assignees
			}
			if cmd.Flags().Changed("label") {
				body["labels"] = labels
			}

			if len(body) == 0 {
				return fmt.Errorf("at least one field must be specified to update")
			}

			resp, err := client.Patch(path, body)
			if err != nil {
				return err
			}

			return output.FormatRaw(f.Format, resp, issueColumns)
		},
	}

	cmd.Flags().StringVar(&name, "name", "", "Issue name")
	cmd.Flags().StringVar(&description, "description", "", "Issue description (HTML)")
	cmd.Flags().StringVar(&state, "state", "", "State ID")
	cmd.Flags().StringVar(&priority, "priority", "", "Priority: urgent, high, medium, low, none")
	cmd.Flags().StringSliceVar(&assignees, "assignee", nil, "Assignee user IDs")
	cmd.Flags().StringSliceVar(&labels, "label", nil, "Label IDs")

	return cmd
}

func newDeleteCmd(f *cmdutil.Factory) *cobra.Command {
	return &cobra.Command{
		Use:   "delete <issue-id>",
		Short: "Delete an issue",
		Args:  cobra.ExactArgs(1),
		RunE: func(cmd *cobra.Command, args []string) error {
			client, err := f.Client()
			if err != nil {
				return err
			}
			ws, proj, err := f.RequireWorkspaceAndProject()
			if err != nil {
				return err
			}

			path, err := api.NewPath(workItemPath()+"{issue_id}/").
				Workspace(ws).Project(proj).Param("issue_id", args[0]).Build()
			if err != nil {
				return err
			}

			_, err = client.Delete(path)
			if err != nil {
				return err
			}

			output.Println("Issue deleted:", args[0])
