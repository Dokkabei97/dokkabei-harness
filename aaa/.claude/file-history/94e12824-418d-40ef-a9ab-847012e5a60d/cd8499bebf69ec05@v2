package issue

import (
	"fmt"

	"github.com/spf13/cobra"

	"github.com/plane-cli/plane-cli/internal/api"
	"github.com/plane-cli/plane-cli/internal/cmdutil"
	"github.com/plane-cli/plane-cli/internal/output"
)

// NewCmd creates the issue command.
func NewCmd(f *cmdutil.Factory) *cobra.Command {
	cmd := &cobra.Command{
		Use:     "issue",
		Aliases: []string{"i"},
		Short:   "Manage work items (issues)",
	}

	cmd.AddCommand(newListCmd(f))
	cmd.AddCommand(newGetCmd(f))
	cmd.AddCommand(newGetBySeqCmd(f))
	cmd.AddCommand(newSearchCmd(f))
	cmd.AddCommand(newCreateCmd(f))
	cmd.AddCommand(newUpdateCmd(f))
	cmd.AddCommand(newDeleteCmd(f))

	return cmd
}

var issueColumns = []output.Column{
	{Header: "ID", Field: "id"},
	{Header: "SEQ", Field: "sequence_id"},
	{Header: "NAME", Field: "name"},
	{Header: "STATE", Field: "state"},
	{Header: "PRIORITY", Field: "priority"},
	{Header: "ASSIGNEES", Field: "assignees"},
}

func workItemPath() string {
	return "workspaces/{workspace_slug}/projects/{project_id}/work-items/"
}

func newListCmd(f *cmdutil.Factory) *cobra.Command {
	var state, priority, assignee string
	var perPage int
	var cursor string

	cmd := &cobra.Command{
		Use:   "list",
		Short: "List issues in a project",
		RunE: func(cmd *cobra.Command, args []string) error {
			client, err := f.Client()
			if err != nil {
				return err
			}
			ws, proj, err := f.RequireWorkspaceAndProject()
			if err != nil {
				return err
			}

			p := api.NewPath(workItemPath()).Workspace(ws).Project(proj)
			p.QueryInt("per_page", perPage)
			p.Query("cursor", cursor)
			p.Query("state", state)
			p.Query("priority", priority)
			p.Query("assignees", assignee)

			path, err := p.Build()
			if err != nil {
				return err
			}

			resp, err := client.Get(path)
			if err != nil {
				return err
			}

			return output.FormatRaw(f.Format, resp, issueColumns)
		},
	}

	cmd.Flags().StringVar(&state, "state", "", "Filter by state ID")
	cmd.Flags().StringVar(&priority, "priority", "", "Filter by priority (urgent, high, medium, low, none)")
	cmd.Flags().StringVar(&assignee, "assignee", "", "Filter by assignee ID")
	cmd.Flags().IntVar(&perPage, "per-page", 100, "Items per page (max 100)")
	cmd.Flags().StringVar(&cursor, "cursor", "", "Pagination cursor")

	return cmd
}

