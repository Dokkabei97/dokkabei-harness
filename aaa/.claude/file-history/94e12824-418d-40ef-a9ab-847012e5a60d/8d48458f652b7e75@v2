package cmdutil

import "github.com/spf13/cobra"

// AddFormatFlag adds the --format flag to a command.
func AddFormatFlag(cmd *cobra.Command, format *string) {
	cmd.Flags().StringVar(format, "format", "", "Output format: json, table")
}

// AddPaginationFlags adds pagination flags.
func AddPaginationFlags(cmd *cobra.Command, perPage *int, cursor *string) {
	cmd.Flags().IntVar(perPage, "per-page", 100, "Number of items per page (max 100)")
	cmd.Flags().StringVar(cursor, "cursor", "", "Pagination cursor")
}

// StringPtr returns a pointer to a string if it's non-empty.
func StringPtr(s string) *string {
	if s == "" {
		return nil
	}
	return &s
}

// IntPtr returns a pointer to an int.
func IntPtr(i int) *int {
	return &i
}
