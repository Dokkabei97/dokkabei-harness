package api

import (
	"fmt"
	"net/url"
	"strings"
)

// PathBuilder constructs API paths with parameter substitution.
type PathBuilder struct {
	template string
	params   map[string]string
	query    url.Values
}

// NewPath creates a new PathBuilder with the given template.
// Templates use {param} placeholders, e.g., "workspaces/{workspace_slug}/projects/{project_id}".
func NewPath(template string) *PathBuilder {
	return &PathBuilder{
		template: template,
		params:   make(map[string]string),
		query:    make(url.Values),
	}
}

// Param sets a path parameter.
func (p *PathBuilder) Param(key, value string) *PathBuilder {
	p.params[key] = value
	return p
}

// Workspace sets the workspace_slug parameter.
func (p *PathBuilder) Workspace(slug string) *PathBuilder {
	return p.Param("workspace_slug", slug)
}

// Project sets the project_id parameter.
func (p *PathBuilder) Project(id string) *PathBuilder {
	return p.Param("project_id", id)
}

// Query adds a query parameter.
func (p *PathBuilder) Query(key, value string) *PathBuilder {
	if value != "" {
		p.query.Set(key, value)
	}
	return p
}

// QueryInt adds an integer query parameter.
func (p *PathBuilder) QueryInt(key string, value int) *PathBuilder {
	if value > 0 {
		p.query.Set(key, fmt.Sprintf("%d", value))
	}
	return p
}

// Build constructs the final URL path with query string.
func (p *PathBuilder) Build() (string, error) {
	path := p.template
	for key, value := range p.params {
		placeholder := "{" + key + "}"
		if !strings.Contains(path, placeholder) {
			return "", fmt.Errorf("unknown path parameter: %s", key)
		}
		if value == "" {
			return "", fmt.Errorf("missing required path parameter: %s", key)
		}
		path = strings.ReplaceAll(path, placeholder, url.PathEscape(value))
	}

	// Check for unresolved placeholders
	if idx := strings.Index(path, "{"); idx >= 0 {
		end := strings.Index(path[idx:], "}")
		if end > 0 {
			return "", fmt.Errorf("unresolved path parameter: %s", path[idx:idx+end+1])
		}
	}

	if len(p.query) > 0 {
		path += "?" + p.query.Encode()
	}

	return path, nil
}
