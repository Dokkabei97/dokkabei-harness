package label

import (
	"fmt"

	"github.com/spf13/cobra"

	"github.com/plane-cli/plane-cli/internal/api"
	"github.com/plane-cli/plane-cli/internal/cmdutil"
	"github.com/plane-cli/plane-cli/internal/output"
)

// NewCmd creates the label command.
func NewCmd(f *cmdutil.Factory) *cobra.Command {
	cmd := &cobra.Command{
		Use:   "label",
		Short: "Manage project labels",
	}

	cmd.AddCommand(newListCmd(f))
	cmd.AddCommand(newGetCmd(f))
	cmd.AddCommand(newCreateCmd(f))
	cmd.AddCommand(newUpdateCmd(f))
	cmd.AddCommand(newDeleteCmd(f))

	return cmd
}

var labelColumns = []output.Column{
	{Header: "ID", Field: "id"},
	{Header: "NAME", Field: "name"},
	{Header: "COLOR", Field: "color"},
	{Header: "PARENT", Field: "parent"},
}

func labelPath() string {
	return "workspaces/{workspace_slug}/projects/{project_id}/labels/"
}

func newListCmd(f *cmdutil.Factory) *cobra.Command {
	return &cobra.Command{
		Use:   "list",
		Short: "List labels in a project",
		RunE: func(cmd *cobra.Command, args []string) error {
			client, err := f.Client()
			if err != nil {
				return err
			}
			ws, proj, err := f.RequireWorkspaceAndProject()
			if err != nil {
				return err
			}

			path, err := api.NewPath(labelPath()).Workspace(ws).Project(proj).Build()
			if err != nil {
				return err
			}

			resp, err := client.Get(path)
			if err != nil {
				return err
			}

			return output.FormatRaw(f.Format, resp, labelColumns)
		},
	}
}

func newGetCmd(f *cmdutil.Factory) *cobra.Command {
	return &cobra.Command{
		Use:   "get <label-id>",
		Short: "Get label details",
		Args:  cobra.ExactArgs(1),
		RunE: func(cmd *cobra.Command, args []string) error {
			client, err := f.Client()
			if err != nil {
				return err
			}
			ws, proj, err := f.RequireWorkspaceAndProject()
			if err != nil {
				return err
			}

			path, err := api.NewPath(labelPath()+"{label_id}/").
				Workspace(ws).Project(proj).Param("label_id", args[0]).Build()
			if err != nil {
				return err
			}

			resp, err := client.Get(path)
			if err != nil {
				return err
			}

			return output.FormatRaw(f.Format, resp, labelColumns)
		},
	}
}

func newCreateCmd(f *cmdutil.Factory) *cobra.Command {
	var name, color, parent string

	cmd := &cobra.Command{
		Use:   "create",
		Short: "Create a new label",
		RunE: func(cmd *cobra.Command, args []string) error {
			if name == "" {
				return fmt.Errorf("--name is required")
			}

			client, err := f.Client()
			if err != nil {
				return err
			}
			ws, proj, err := f.RequireWorkspaceAndProject()
			if err != nil {
				return err
			}

			path, err := api.NewPath(labelPath()).Workspace(ws).Project(proj).Build()
			if err != nil {
				return err
			}

			body := map[string]interface{}{
				"name": name,
			}
			if color != "" {
				body["color"] = color
			}
			if parent != "" {
				body["parent"] = parent
			}

			resp, err := client.Post(path, body)
			if err != nil {
				return err
			}

			return output.FormatRaw(f.Format, resp, labelColumns)
		},
	}

	cmd.Flags().StringVar(&name, "name", "", "Label name (required)")
	cmd.Flags().StringVar(&color, "color", "", "Label color (hex)")
	cmd.Flags().StringVar(&parent, "parent", "", "Parent label ID")

	return cmd
}

func newUpdateCmd(f *cmdutil.Factory) *cobra.Command {
	var name, color string

	cmd := &cobra.Command{
		Use:   "update <label-id>",
		Short: "Update a label",
		Args:  cobra.ExactArgs(1),
		RunE: func(cmd *cobra.Command, args []string) error {
			client, err := f.Client()
			if err != nil {
				return err
			}
			ws, proj, err := f.RequireWorkspaceAndProject()
			if err != nil {
				return err
			}

			path, err := api.NewPath(labelPath()+"{label_id}/").
				Workspace(ws).Project(proj).Param("label_id", args[0]).Build()
			if err != nil {
				return err
			}

			body := make(map[string]interface{})
			if cmd.Flags().Changed("name") {
				body["name"] = name
			}
			if cmd.Flags().Changed("color") {
				body["color"] = color
			}

			if len(body) == 0 {
				return fmt.Errorf("at least one field must be specified to update")
			}

			resp, err := client.Patch(path, body)
			if err != nil {
				return err
			}

			return output.FormatRaw(f.Format, resp, labelColumns)
		},
	}

	cmd.Flags().StringVar(&name, "name", "", "Label name")
	cmd.Flags().StringVar(&color, "color", "", "Label color (hex)")

	return cmd
}

func newDeleteCmd(f *cmdutil.Factory) *cobra.Command {
	return &cobra.Command{
		Use:   "delete <label-id>",
		Short: "Delete a label",
		Args:  cobra.ExactArgs(1),
		RunE: func(cmd *cobra.Command, args []string) error {
			client, err := f.Client()
			if err != nil {
				return err
			}
			ws, proj, err := f.RequireWorkspaceAndProject()
			if err != nil {
				return err
			}

			path, err := api.NewPath(labelPath()+"{label_id}/").
				Workspace(ws).Project(proj).Param("label_id", args[0]).Build()
			if err != nil {
				return err
			}

			_, err = client.Delete(path)
			if err != nil {
				return err
			}

			output.Println("Label deleted:", args[0])
			return nil
		},
	}
}
