package output

import (
	"encoding/json"
)

// Formatter defines the interface for output formatting.
type Formatter interface {
	Format(data interface{}) error
}

// Format outputs data using the specified format.
func Format(format string, data interface{}, columns []Column) error {
	switch format {
	case "table":
		return NewTableFormatter(columns).Format(data)
	default:
		return NewJSONFormatter().Format(data)
	}
}

// FormatRaw outputs raw JSON data.
func FormatRaw(format string, data json.RawMessage, columns []Column) error {
	switch format {
	case "table":
		return NewTableFormatter(columns).Format(data)
	default:
		return NewJSONRawFormatter().Format(data)
	}
}

// Column defines a table column.
type Column struct {
	Header string
	Field  string
	Width  int
}

// InjectField adds a field to a JSON response (object or array of objects).
func InjectField(data json.RawMessage, key string, value interface{}) json.RawMessage {
	// Try single object
	var obj map[string]interface{}
	if err := json.Unmarshal(data, &obj); err == nil {
		obj[key] = value
		out, _ := json.Marshal(obj)
		return out
	}

	// Try array
	var arr []map[string]interface{}
	if err := json.Unmarshal(data, &arr); err == nil {
		for i := range arr {
			arr[i][key] = value
		}
		out, _ := json.Marshal(arr)
		return out
	}

	return data
}
