package models

// Teamspace represents a workspace team.
type Teamspace struct {
	ID          string   `json:"id"`
	Name        string   `json:"name"`
	Description string   `json:"description,omitempty"`
	Members     []string `json:"members,omitempty"`
	Projects    []string `json:"projects,omitempty"`
	Workspace   string   `json:"workspace"`
	Timestamps
}

// CreateTeamspaceRequest is the request body for creating a teamspace.
type CreateTeamspaceRequest struct {
	Name        string   `json:"name"`
	Description string   `json:"description,omitempty"`
	Members     []string `json:"members,omitempty"`
	Projects    []string `json:"projects,omitempty"`
}

// UpdateTeamspaceRequest is the request body for updating a teamspace.
type UpdateTeamspaceRequest struct {
	Name        *string  `json:"name,omitempty"`
	Description *string  `json:"description,omitempty"`
	Members     []string `json:"members,omitempty"`
	Projects    []string `json:"projects,omitempty"`
}
