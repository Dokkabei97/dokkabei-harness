package models

// Member represents a workspace or project member.
type Member struct {
	ID          string  `json:"id"`
	Member      UserRef `json:"member"`
	Role        int     `json:"role"` // 5=guest, 10=viewer, 15=member, 20=admin
	Timestamps
}

// RoleName returns the human-readable role name.
func RoleName(role int) string {
	switch role {
	case 5:
		return "Guest"
	case 10:
		return "Viewer"
	case 15:
		return "Member"
	case 20:
		return "Admin"
	default:
		return "Unknown"
	}
}
