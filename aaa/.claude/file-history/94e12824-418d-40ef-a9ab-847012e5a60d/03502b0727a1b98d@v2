package api

import (
	"bytes"
	"context"
	"encoding/json"
	"fmt"
	"io"
	"net/http"
	"os"
	"strings"
	"time"

	"golang.org/x/time/rate"
)

// Client is the HTTP client for Plane API.
type Client struct {
	httpClient *http.Client
	baseURL    string
	apiKey     string
	limiter    *rate.Limiter
	debug      bool
}

// ClientOption configures the Client.
type ClientOption func(*Client)

// WithDebug enables HTTP request/response logging.
func WithDebug(debug bool) ClientOption {
	return func(c *Client) {
		c.debug = debug
	}
}

// NewClient creates a new API client.
func NewClient(baseURL, apiKey string, opts ...ClientOption) *Client {
	// Normalize base URL
	baseURL = strings.TrimRight(baseURL, "/")

	c := &Client{
		httpClient: &http.Client{
			Timeout: 30 * time.Second,
		},
		baseURL: baseURL,
		apiKey:  apiKey,
		// 55 req/min with burst of 10 (safety margin from 60 req/min limit)
		limiter: rate.NewLimiter(rate.Every(time.Minute/55), 10),
	}

	for _, opt := range opts {
		opt(c)
	}

	return c
}

// do executes an HTTP request with rate limiting, auth, and error handling.
func (c *Client) do(ctx context.Context, method, path string, body interface{}) (json.RawMessage, error) {
	// Rate limiting
	if err := c.limiter.Wait(ctx); err != nil {
		return nil, fmt.Errorf("rate limit: %w", err)
	}

	// Build full URL
	fullURL := c.baseURL + "/api/v1/" + strings.TrimLeft(path, "/")

	// Prepare body
	var bodyReader io.Reader
	if body != nil {
		data, err := json.Marshal(body)
		if err != nil {
			return nil, fmt.Errorf("marshaling request body: %w", err)
		}
		bodyReader = bytes.NewReader(data)
	}

	req, err := http.NewRequestWithContext(ctx, method, fullURL, bodyReader)
	if err != nil {
		return nil, fmt.Errorf("creating request: %w", err)
	}

	// Headers
	req.Header.Set("X-API-Key", c.apiKey)
	req.Header.Set("Content-Type", "application/json")
	req.Header.Set("Accept", "application/json")

	if c.debug {
		fmt.Fprintf(os.Stderr, "[DEBUG] %s %s\n", method, fullURL)
		if body != nil {
			data, _ := json.MarshalIndent(body, "", "  ")
			fmt.Fprintf(os.Stderr, "[DEBUG] Body: %s\n", string(data))
		}
	}

	resp, err := c.httpClient.Do(req)
	if err != nil {
		return nil, fmt.Errorf("executing request: %w", err)
	}
	defer resp.Body.Close()

	respBody, err := io.ReadAll(resp.Body)
	if err != nil {
		return nil, fmt.Errorf("reading response: %w", err)
	}

	if c.debug {
		fmt.Fprintf(os.Stderr, "[DEBUG] Response: %d %s\n", resp.StatusCode, resp.Status)
		if len(respBody) > 0 && len(respBody) < 2000 {
			fmt.Fprintf(os.Stderr, "[DEBUG] Body: %s\n", string(respBody))
		}
	}

	// Handle errors
	if resp.StatusCode >= 400 {
		apiErr := parseAPIError(resp, respBody)
		return nil, apiErr
	}

	// Handle 204 No Content
	if resp.StatusCode == http.StatusNoContent || len(respBody) == 0 {
		return json.RawMessage("null"), nil
	}

	return json.RawMessage(respBody), nil
}

// Get performs a GET request.
func (c *Client) Get(path string) (json.RawMessage, error) {
	return c.do(context.Background(), http.MethodGet, path, nil)
}

// Post performs a POST request.
func (c *Client) Post(path string, body interface{}) (json.RawMessage, error) {
	return c.do(context.Background(), http.MethodPost, path, body)
}

// Patch performs a PATCH request.
func (c *Client) Patch(path string, body interface{}) (json.RawMessage, error) {
	return c.do(context.Background(), http.MethodPatch, path, body)
}

// Put performs a PUT request.
func (c *Client) Put(path string, body interface{}) (json.RawMessage, error) {
	return c.do(context.Background(), http.MethodPut, path, body)
}

// Delete performs a DELETE request.
func (c *Client) Delete(path string) (json.RawMessage, error) {
	return c.do(context.Background(), http.MethodDelete, path, nil)
}

// DeleteWithBody performs a DELETE request with a body.
func (c *Client) DeleteWithBody(path string, body interface{}) (json.RawMessage, error) {
	return c.do(context.Background(), http.MethodDelete, path, body)
}
