package state

import (
	"fmt"

	"github.com/spf13/cobra"

	"github.com/plane-cli/plane-cli/internal/api"
	"github.com/plane-cli/plane-cli/internal/cmdutil"
	"github.com/plane-cli/plane-cli/internal/output"
)

// NewCmd creates the state command.
func NewCmd(f *cmdutil.Factory) *cobra.Command {
	cmd := &cobra.Command{
		Use:   "state",
		Short: "Manage workflow states",
	}

	cmd.AddCommand(newListCmd(f))
	cmd.AddCommand(newGetCmd(f))
	cmd.AddCommand(newCreateCmd(f))
	cmd.AddCommand(newUpdateCmd(f))
	cmd.AddCommand(newDeleteCmd(f))

	return cmd
}

var stateColumns = []output.Column{
	{Header: "ID", Field: "id"},
	{Header: "NAME", Field: "name"},
	{Header: "GROUP", Field: "group"},
	{Header: "COLOR", Field: "color"},
	{Header: "DEFAULT", Field: "is_default"},
}

func statePath() string {
	return "workspaces/{workspace_slug}/projects/{project_id}/states/"
}

func newListCmd(f *cmdutil.Factory) *cobra.Command {
	return &cobra.Command{
		Use:   "list",
		Short: "List states in a project",
		RunE: func(cmd *cobra.Command, args []string) error {
			client, err := f.Client()
			if err != nil {
				return err
			}
			ws, proj, err := f.RequireWorkspaceAndProject()
			if err != nil {
				return err
			}

			path, err := api.NewPath(statePath()).Workspace(ws).Project(proj).Build()
			if err != nil {
				return err
			}

			resp, err := client.Get(path)
			if err != nil {
				return err
			}

			return output.FormatRaw(f.Format, resp, stateColumns)
		},
	}
}

func newGetCmd(f *cmdutil.Factory) *cobra.Command {
	return &cobra.Command{
		Use:   "get <state-id>",
		Short: "Get state details",
		Args:  cobra.ExactArgs(1),
		RunE: func(cmd *cobra.Command, args []string) error {
			client, err := f.Client()
			if err != nil {
				return err
			}
			ws, proj, err := f.RequireWorkspaceAndProject()
			if err != nil {
				return err
			}

			path, err := api.NewPath(statePath()+"{state_id}/").
				Workspace(ws).Project(proj).Param("state_id", args[0]).Build()
			if err != nil {
				return err
			}

			resp, err := client.Get(path)
			if err != nil {
				return err
			}

			return output.FormatRaw(f.Format, resp, stateColumns)
		},
	}
}

func newCreateCmd(f *cmdutil.Factory) *cobra.Command {
	var name, color, group, description string

	cmd := &cobra.Command{
		Use:   "create",
		Short: "Create a new state",
		RunE: func(cmd *cobra.Command, args []string) error {
			if name == "" {
				return fmt.Errorf("--name is required")
			}
			if group == "" {
				return fmt.Errorf("--group is required (backlog, unstarted, started, completed, cancelled)")
			}

			client, err := f.Client()
			if err != nil {
				return err
			}
			ws, proj, err := f.RequireWorkspaceAndProject()
			if err != nil {
				return err
			}

			path, err := api.NewPath(statePath()).Workspace(ws).Project(proj).Build()
			if err != nil {
				return err
			}

			body := map[string]interface{}{
				"name":  name,
				"group": group,
			}
			if color != "" {
				body["color"] = color
			}
			if description != "" {
				body["description"] = description
			}

			resp, err := client.Post(path, body)
			if err != nil {
				return err
			}

			return output.FormatRaw(f.Format, resp, stateColumns)
		},
	}

	cmd.Flags().StringVar(&name, "name", "", "State name (required)")
	cmd.Flags().StringVar(&color, "color", "", "State color (hex)")
	cmd.Flags().StringVar(&group, "group", "", "State group: backlog, unstarted, started, completed, cancelled (required)")
	cmd.Flags().StringVar(&description, "description", "", "State description")

	return cmd
}

func newUpdateCmd(f *cmdutil.Factory) *cobra.Command {
	var name, color, group, description string

	cmd := &cobra.Command{
		Use:   "update <state-id>",
		Short: "Update a state",
		Args:  cobra.ExactArgs(1),
		RunE: func(cmd *cobra.Command, args []string) error {
			client, err := f.Client()
			if err != nil {
				return err
			}
			ws, proj, err := f.RequireWorkspaceAndProject()
			if err != nil {
				return err
			}

			path, err := api.NewPath(statePath()+"{state_id}/").
				Workspace(ws).Project(proj).Param("state_id", args[0]).Build()
			if err != nil {
				return err
			}

			body := make(map[string]interface{})
			if cmd.Flags().Changed("name") {
				body["name"] = name
			}
			if cmd.Flags().Changed("color") {
				body["color"] = color
			}
			if cmd.Flags().Changed("group") {
				body["group"] = group
			}
			if cmd.Flags().Changed("description") {
				body["description"] = description
			}

			if len(body) == 0 {
				return fmt.Errorf("at least one field must be specified to update")
			}

			resp, err := client.Patch(path, body)
			if err != nil {
				return err
			}

			return output.FormatRaw(f.Format, resp, stateColumns)
		},
	}

	cmd.Flags().StringVar(&name, "name", "", "State name")
	cmd.Flags().StringVar(&color, "color", "", "State color (hex)")
	cmd.Flags().StringVar(&group, "group", "", "State group")
	cmd.Flags().StringVar(&description, "description", "", "State description")

	return cmd
}

func newDeleteCmd(f *cmdutil.Factory) *cobra.Command {
	return &cobra.Command{
		Use:   "delete <state-id>",
		Short: "Delete a state",
		Args:  cobra.ExactArgs(1),
		RunE: func(cmd *cobra.Command, args []string) error {
			client, err := f.Client()
			if err != nil {
				return err
			}
			ws, proj, err := f.RequireWorkspaceAndProject()
			if err != nil {
				return err
			}

			path, err := api.NewPath(statePath()+"{state_id}/").
				Workspace(ws).Project(proj).Param("state_id", args[0]).Build()
			if err != nil {
				return err
			}

			_, err = client.Delete(path)
			if err != nil {
				return err
			}

			output.Println("State deleted:", args[0])
			return nil
		},
	}
}
