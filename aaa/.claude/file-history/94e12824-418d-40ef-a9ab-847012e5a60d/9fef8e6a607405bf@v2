package models

// Sticky represents a sticky note.
type Sticky struct {
	ID          string `json:"id"`
	Name        string `json:"name"`
	Description string `json:"description,omitempty"`
	Color       string `json:"color,omitempty"`
	Workspace   string `json:"workspace"`
	CreatedBy   string `json:"created_by"`
	Timestamps
}

// CreateStickyRequest is the request body for creating a sticky.
type CreateStickyRequest struct {
	Name        string `json:"name"`
	Description string `json:"description,omitempty"`
	Color       string `json:"color,omitempty"`
}

// UpdateStickyRequest is the request body for updating a sticky.
type UpdateStickyRequest struct {
	Name        *string `json:"name,omitempty"`
	Description *string `json:"description,omitempty"`
	Color       *string `json:"color,omitempty"`
}
