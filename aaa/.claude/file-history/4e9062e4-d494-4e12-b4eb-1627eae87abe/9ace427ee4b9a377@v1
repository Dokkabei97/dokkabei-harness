package com.cowave.search.dictionary.service

import co.elastic.clients.elasticsearch._types.mapping.DynamicMapping
import co.elastic.clients.transport.rest5_client.low_level.Request
import com.cowave.search.common.elasticsearch.ElasticsearchClientFactory
import com.cowave.search.dictionary.dto.AllTypesCountResponse
import com.cowave.search.dictionary.dto.AllTypesLastModifiedResponse
import com.cowave.search.dictionary.dto.CompileResult
import com.cowave.search.dictionary.dto.CursorPagedResponse
import com.cowave.search.dictionary.dto.DictApplyHistory
import com.cowave.search.dictionary.dto.DictionarySetting
import com.cowave.search.dictionary.dto.SearchColumn
import com.cowave.search.dictionary.dto.SortType
import com.cowave.search.dictionary.dto.TypeCountResponse
import com.cowave.search.dictionary.dto.TypeLastModifiedResponse
import com.cowave.search.dictionary.infrastructure.DictionaryRepositoryImpl.Companion.DICT_APPLY_INDEX
import com.cowave.search.dictionary.model.Dictionary
import com.cowave.search.dictionary.model.Type
import com.cowave.search.utils.DictionaryBinaryCompile
import org.slf4j.LoggerFactory
import org.springframework.stereotype.Service
import org.springframework.web.multipart.MultipartFile
import java.time.Instant

@Service
class DictionaryService(
    val dictionaryRepository: DictionaryRepository,
    val dictionaryBinaryCompile: DictionaryBinaryCompile,
    private val clientFactory: ElasticsearchClientFactory,
) {
    private val logger = LoggerFactory.getLogger(DictionaryService::class.java)

    fun search(
        clusterId: String,
        type: Type,
        size: Int,
        searchColumn: SearchColumn = SearchColumn.ALL,
        word: String? = null,
        isMatch: Boolean = false,
        cursor: String? = null,
        sortType: SortType = SortType.UPDATED,
    ): CursorPagedResponse<Dictionary> {
        val searchAfterList = cursor?.split(CURSOR_DELIMITER)
        val result =
            dictionaryRepository.search(
                clusterId = clusterId,
                type = type,
                size = size,
                searchColumn = searchColumn,
                value = word,
                isMatch = isMatch,
                searchAfter = searchAfterList,
                sortType = sortType,
            )

        return CursorPagedResponse(
            items = result.items,
            total = result.total,
            cursor = result.searchAfter?.joinToString(CURSOR_DELIMITER),
            hasNext = result.hasNext,
        )
    }

    fun create(
        clusterId: String,
        keyword: String?,
        type: Type,
        value: String?,
    ) {
        dictionaryRepository.insert(clusterId, keyword, type, value)
    }

    fun update(
        clusterId: String,
        id: String,
        keyword: String,
        type: Type,
        value: String?,
    ) {
        dictionaryRepository.update(clusterId, id, keyword, type, value)
    }

    fun delete(
        clusterId: String,
        id: String,
    ) {
        dictionaryRepository.delete(clusterId, id)
    }

    fun countByType(
        clusterId: String,
        type: Type,
    ): Long = dictionaryRepository.countByType(clusterId, type)

    fun compile(
        clusterId: String,
        type: Type,
    ): CompileResult {
        val result = compileWithoutReload(clusterId, type)
        reloadDictionary(clusterId)
        return result
    }

    fun compileAll(clusterId: String): List<CompileResult> {
        val results: List<CompileResult> = Type.entries.map { compileWithoutReload(clusterId, it) }
        reloadDictionary(clusterId)
        return results
    }

    private fun compileWithoutReload(
        clusterId: String,
        type: Type,
    ): CompileResult {
        val dictionaries = dictionaryRepository.findAllByType(clusterId, type)
        val pairs = dictionaries.map { it.keyword to it.value }
        val outputFile = dictionaryBinaryCompile.compileToConfiguredPath(pairs, type)

        return CompileResult(
            type = type,
            count = dictionaries.size,
            filePath = outputFile.absolutePath,
            fileSize = outputFile.length(),
        )
    }

    private fun reloadDictionary(clusterId: String) {
        logger.info("Reloading dictionary in Elasticsearch cluster: {}", clusterId)
        val restClient = clientFactory.getLowLevelClient(clusterId)
        val request = Request("POST", "/_analysis-product-name/reload-dict")
        val response = restClient.performRequest(request)
        val statusCode = response.statusCode
        if (statusCode !in 200..299) {
            throw RuntimeException("Failed to reload dictionary: HTTP $statusCode")
        }
        logger.info("Dictionary reload completed successfully for cluster: {}", clusterId)
    }

    fun getLastModifiedByType(
        clusterId: String,
        type: Type,
    ): TypeLastModifiedResponse {
        val (lastModified, count) = dictionaryRepository.findLastModifiedByType(clusterId, type)
        return TypeLastModifiedResponse(
            type = type,
            lastModified = lastModified,
            count = count,
        )
    }

    fun getAllTypesLastModified(clusterId: String): AllTypesLastModifiedResponse {
        val allTypesData = dictionaryRepository.findLastModifiedForAllTypes(clusterId)
        val items =
            Type.entries.map { type ->
                val (lastModified, count) = allTypesData[type] ?: Pair(null, 0L)
                TypeLastModifiedResponse(
                    type = type,
                    lastModified = lastModified,
                    count = count,
                )
            }
        return AllTypesLastModifiedResponse(items)
    }

    fun getAllTypesCounts(clusterId: String): AllTypesCountResponse {
        val allTypesCounts = dictionaryRepository.countAllTypes(clusterId)
        val items =
            Type.entries.map { type ->
                TypeCountResponse(
                    type = type,
                    count = allTypesCounts[type] ?: 0L,
                )
            }
        val totalCount = items.sumOf { it.count }
        return AllTypesCountResponse(items, totalCount)
    }

    // ── 파일 업로드 일괄 등록 ─────────────────────────────────────────────

    fun fileUpload(
        clusterId: String,
        type: Type,
        file: MultipartFile,
    ): Int {
        val entries =
            file.inputStream.bufferedReader().useLines { lines ->
                lines
                    .filter { it.isNotBlank() }
                    .map { line ->
                        val parts = line.split("\t", limit = 2)
                        val keyword = parts[0].trim().takeIf { it.isNotEmpty() }
                        val value = parts.getOrNull(1)?.trim()
                        Dictionary.of(
                            keyword = keyword,
                            type = type,
                            value = value,
                            createdTime = Instant.now(),
                            updatedTime = Instant.now(),
                        )
                    }.toList()
            }
        dictionaryRepository.bulkInsert(clusterId, entries)
        return entries.size
    }

    // ── 전체 다운로드 ─────────────────────────────────────────────────────

    fun downloadAll(
        clusterId: String,
        type: Type,
    ): String {
        val dictionaries = dictionaryRepository.findAllByType(clusterId, type)
        return dictionaries.joinToString("\n") { dict ->
            if (dict.value != null) "${dict.keyword}\t${dict.value}" else dict.keyword ?: ""
        }
    }

    // ── 전체 삭제 ─────────────────────────────────────────────────────────

    fun resetDict(
        clusterId: String,
        type: Type,
    ) {
        dictionaryRepository.deleteAllByType(clusterId, type)
    }

    // ── 사전 설정 조회 ────────────────────────────────────────────────────

    fun getSettings(clusterId: String): List<DictionarySetting> {
        val esClient = clientFactory.getClient(clusterId)
        return runCatching {
            val indexExists =
                esClient
                    .indices()
                    .exists { it.index("dsearch-dict") }
                    .value()
            if (!indexExists) {
                ensureDictIndexExists(clusterId)
            }
            val mapping = esClient.indices().getMapping { it.index("dsearch-dict") }
            Type.entries.map { type ->
                DictionarySetting(
                    type = type,
                    indexName = "dsearch-dict",
                    mappingExists = mapping.mappings().containsKey("dsearch-dict"),
                )
            }
        }.getOrElse {
            logger.warn("사전 설정 조회 실패 [{}]: {}", clusterId, it.message)
            Type.entries.map { type -> DictionarySetting(type = type, indexName = "dsearch-dict", mappingExists = false) }
        }
    }

    private fun ensureDictIndexExists(clusterId: String) {
        val esClient = clientFactory.getClient(clusterId)
        esClient.indices().create { req ->
            req.index("dsearch-dict").mappings { m ->
                m
                    .dynamic(DynamicMapping.True)
                    .properties("type") { p -> p.keyword { it } }
                    .properties("keyword") { p -> p.keyword { k -> k.fields("text") { f -> f.text { it } } } }
                    .properties("value") { p -> p.text { t -> t.fields("raw") { f -> f.keyword { it } } } }
                    .properties("createdTime") { p -> p.date { it } }
                    .properties("updatedTime") { p -> p.date { it } }
            }
        }
        logger.info("dsearch-dict 인덱스 생성: {}", clusterId)
    }

    // ── 배포 이력 조회 ────────────────────────────────────────────────────

    fun getApplyHistory(
        clusterId: String,
        size: Int,
    ): List<DictApplyHistory> {
        val esClient = clientFactory.getClient(clusterId)
        return runCatching {
            val response =
                esClient.search(
                    { s ->
                        s
                            .index(DICT_APPLY_INDEX)
                            .size(size)
                            .sort { so ->
                                so.field { f -> f.field("applyTime").order(co.elastic.clients.elasticsearch._types.SortOrder.Desc) }
                            }
                    },
                    DictApplyHistory::class.java,
                )
            response.hits().hits().mapNotNull { it.source() }
        }.getOrElse {
            logger.warn("배포 이력 조회 실패 [{}]: {}", clusterId, it.message)
            emptyList()
        }
    }

    fun saveApplyHistory(
        clusterId: String,
        history: DictApplyHistory,
    ) {
        val esClient = clientFactory.getClient(clusterId)
        runCatching {
            esClient.index { it.index(DICT_APPLY_INDEX).document(history) }
        }.onFailure { e ->
            logger.warn("배포 이력 저장 실패 [{}]: {}", clusterId, e.message)
        }
    }

    companion object {
        private const val CURSOR_DELIMITER = "|"
    }
}
