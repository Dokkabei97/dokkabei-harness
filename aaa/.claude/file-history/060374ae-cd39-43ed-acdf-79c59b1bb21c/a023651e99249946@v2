{
  "plane": {
    "command": "uvx",
    "args": [
      "plane-mcp-server",
      "stdio"
    ],
    "env": {
      "PLANE_API_KEY": "${PLANE_API_KEY}",
      "PLANE_WORKSPACE_SLUG": "danawa",
      "PLANE_BASE_URL": "https://project.cowave.kr"
    }
  },
  "outline": {
    "command": "uvx",
    "args": [
      "mcp-outline"
    ],
    "env": {
      "OUTLINE_API_KEY": "${OUTLINE_API_KEY}",
      "OUTLINE_API_URL": "https://cowave.wiki.cowave.kr/api",
      "OUTLINE_DISABLE_DELETE": "true"
    }
  },
  "grafana": {
    "command": "mcp-grafana",
    "args": [
      "--tls-skip-verify"
    ],
    "env": {
      "GRAFANA_URL": "http://grafana.danuricorp.com:80",
      "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_SERVICE_ACCOUNT_TOKEN}"
    }
  }
}
