### S4.2 멱등성(Idempotency) 구현

**학습 목표**
네트워크 타임아웃, 재시도 시나리오에서 안전성을 보장하기 위한 범용 멱등성 필터를 구현할 수 있다.

**핵심 내용**

*멱등성이 필요한 이유*
```
클라이언트 → 요청 → 서버 (처리 완료)
     ↑                    ↓
     └── 타임아웃! ←── 응답 유실
     ↓
클라이언트 → 재시도 → 서버 (또 처리? → 중복 결제!)
```

*Redis 기반 멱등성 필터*
```kotlin
// 멱등성 키 어노테이션
@Target(AnnotationTarget.FUNCTION)
@Retention(AnnotationRetention.RUNTIME)
annotation class Idempotent(
    val headerName: String = "Idempotency-Key",
    val ttlMinutes: Long = 60
)

// 멱등성 인터셉터
@Component
class IdempotencyInterceptor(
    private val redisTemplate: StringRedisTemplate,
    private val objectMapper: ObjectMapper
) : HandlerInterceptor {

    override fun preHandle(request: HttpServletRequest, response: HttpServletResponse, handler: Any): Boolean {
        if (handler !is HandlerMethod) return true

        val annotation = handler.getMethodAnnotation(Idempotent::class.java) ?: return true
        val idempotencyKey = request.getHeader(annotation.headerName)
            ?: throw BadRequestException("${annotation.headerName} 헤더가 필요합니다")

        val cacheKey = "idempotency:${request.requestURI}:$idempotencyKey"
        val cached = redisTemplate.opsForValue().get(cacheKey)

        if (cached != null) {
            // 이전 응답을 그대로 반환
            val cachedResponse = objectMapper.readValue(cached, CachedResponse::class.java)
            response.status = cachedResponse.status
            response.contentType = "application/json"
            response.writer.write(cachedResponse.body)
            return false  // 컨트롤러 실행 안 함
        }

        // 처리 중 표시 (동시 요청 방지)
        val lockAcquired = redisTemplate.opsForValue()
            .setIfAbsent(cacheKey, "PROCESSING", Duration.ofMinutes(annotation.ttlMinutes))

        if (lockAcquired != true) {
            response.status = 409
            response.writer.write("""{"error": "요청 처리 중입니다. 잠시 후 재시도하세요."}""")
            return false
        }

        return true
    }
}

// AOP 기반 응답 캐싱
@Aspect
@Component
class IdempotencyResponseCapture(
    private val redisTemplate: StringRedisTemplate,
    private val objectMapper: ObjectMapper
) {
    @AfterReturning(
        pointcut = "@annotation(idempotent)",
        returning = "result"
    )
    fun cacheResponse(joinPoint: JoinPoint, idempotent: Idempotent, result: ResponseEntity<*>) {
        val request = (RequestContextHolder.currentRequestAttributes() as ServletRequestAttributes).request
        val key = request.getHeader(idempotent.headerName) ?: return
        val cacheKey = "idempotency:${request.requestURI}:$key"

        val cached = CachedResponse(
            status = result.statusCode.value(),
            body = objectMapper.writeValueAsString(result.body)
        )
        redisTemplate.opsForValue().set(
            cacheKey,
            objectMapper.writeValueAsString(cached),
            Duration.ofMinutes(idempotent.ttlMinutes)
        )
    }
}

// 사용
@PostMapping("/orders")
@Idempotent(ttlMinutes = 30)
fun createOrder(@RequestBody request: CreateOrderRequest): ResponseEntity<OrderResponse> {
    val order = orderService.createOrder(request)
    return ResponseEntity.status(HttpStatus.CREATED).body(order.toResponse())
}
