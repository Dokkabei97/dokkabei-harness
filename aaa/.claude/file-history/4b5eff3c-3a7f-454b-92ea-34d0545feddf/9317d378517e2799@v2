    SearchSourceBuilder().from(10000).size(20)
)

// GOOD: search_after 방식
SearchRequest().source(
    SearchSourceBuilder()
        .size(20)
        .sort("_score", SortOrder.DESC)
        .sort("_id", SortOrder.ASC)
        .searchAfter(arrayOf(lastScore, lastId))
)
```

