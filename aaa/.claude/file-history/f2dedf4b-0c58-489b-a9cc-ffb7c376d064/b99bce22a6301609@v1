```bash
BASE="/Users/admin/Documents/Obsidian Vault/📚학습노트/Senior-Backend"
mkdir -p "$BASE/1장 Kotlin 심화" "$BASE/2장 데이터베이스와 캐싱" "$BASE/3장 메시징과 실시간 통신" "$BASE/4장 Spring 심화와 트래픽 처리" "$BASE/5장 아키텍처와 설계" "$BASE/6장 테스트 보안 동시성" "$BASE/7장 배포와 리더십" "$BASE/8장 JVM 성능" "$BASE/9장 성능 최적화" "$BASE/10장 종합 프로젝트"
