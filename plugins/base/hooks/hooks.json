{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "tool == \"Bash\" && tool_input.command matches \"(npm run dev|pnpm( run)? dev|yarn dev|bun run dev|uvicorn|flask run|python.*manage\\\\.py runserver|uv run.*(uvicorn|flask|manage\\\\.py))\"",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/block-dev-server.js"]
          }
        ],
        "description": "Block dev servers outside tmux - ensures you can access logs (includes Python servers)"
      },
      {
        "matcher": "tool == \"Bash\" && tool_input.command matches \"(npm (install|test)|pnpm (install|test)|yarn (install|test)?|bun (install|test)|cargo build|make|docker|pytest|vitest|playwright|gradlew|pip install|uv (install|sync|pip|run)|tox)\"",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/warn-tmux.js"]
          }
        ],
        "description": "Reminder to use tmux for long-running commands (includes gradlew, pip, uv)"
      },
      {
        "matcher": "tool == \"Bash\" && tool_input.command matches \"git push\"",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/warn-git-push.js"]
          }
        ],
        "description": "Reminder before git push to review changes"
      },
      {
        "matcher": "tool == \"Write\" && tool_input.file_path matches \"\\\\.(md|txt)$\" && !(tool_input.file_path matches \"README\\\\.md|CLAUDE\\\\.md|AGENTS\\\\.md|CONTRIBUTING\\\\.md\")",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/block-md-creation.js"]
          }
        ],
        "description": "Block creation of random .md files - keeps docs consolidated"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "tool == \"Bash\"",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/log-pr-mr.js"]
          }
        ],
        "description": "Log PR/MR URL and provide review command after GitHub PR or GitLab MR creation"
      },
      {
        "matcher": "tool == \"Bash\" && tool_input.command matches \"(npm run build|pnpm build|yarn build)\"",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/notify-build-async.js"],
            "async": true,
            "timeout": 30
          }
        ],
        "description": "Async hook for npm/pnpm/yarn build analysis (runs in background without blocking)"
      },
      {
        "matcher": "tool == \"Bash\" && tool_input.command matches \"gradlew.*build\"",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/notify-gradle-build-async.js"],
            "async": true,
            "timeout": 60
          }
        ],
        "description": "Async hook for Gradle build analysis (runs in background without blocking)"
      },
      {
        "matcher": "tool == \"Edit\" && tool_input.file_path matches \"\\\\.(ts|tsx|js|jsx)$\"",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/format-prettier.js"]
          }
        ],
        "description": "Auto-format JS/TS files with Prettier after edits"
      },
      {
        "matcher": "tool == \"Edit\" && tool_input.file_path matches \"\\\\.(kt|kts)$\"",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/format-ktlint.js"]
          }
        ],
        "description": "Auto-format Kotlin files with ktlintFormat after edits"
      },
      {
        "matcher": "tool == \"Edit\" && tool_input.file_path matches \"\\\\.(ts|tsx)$\"",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/check-tsc.js"]
          }
        ],
        "description": "TypeScript check after editing .ts/.tsx files"
      },
      {
        "matcher": "tool == \"Edit\" && tool_input.file_path matches \"\\\\.(kt|kts)$\"",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/check-kotlin-compile.js"]
          }
        ],
        "description": "Kotlin compile check after editing .kt/.kts files"
      },
      {
        "matcher": "tool == \"Edit\" && tool_input.file_path matches \"\\\\.(ts|tsx|js|jsx)$\"",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/warn-console-log.js"]
          }
        ],
        "description": "Warn about console.log statements after JS/TS edits"
      },
      {
        "matcher": "tool == \"Edit\" && tool_input.file_path matches \"\\\\.(kt|kts)$\"",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/warn-println.js"]
          }
        ],
        "description": "Warn about println() statements after Kotlin edits"
      },
      {
        "matcher": "tool == \"Edit\" && tool_input.file_path matches \"\\\\.py$\"",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/check-py-compile.js"]
          }
        ],
        "description": "Python syntax check with py_compile after editing .py files"
      },
      {
        "matcher": "tool == \"Edit\" && tool_input.file_path matches \"\\\\.py$\"",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/warn-print.js"]
          }
        ],
        "description": "Warn about print() statements after Python edits"
      },
      {
        "matcher": "tool == \"Edit\" && tool_input.file_path matches \"\\\\.(ts|tsx|js|jsx|kt|kts|py|go|java|sql|sh|yaml|yml|json|properties)$|\\\\.env(\\\\.[A-Za-z0-9_-]+)?$\"",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/warn-security.js"]
          }
        ],
        "description": "Warn about high-signal security patterns (secrets, injection, unsafe deserialization, TLS bypass, XSS) after Edit on code files"
      },
      {
        "matcher": "tool == \"Write\" && tool_input.file_path matches \"\\\\.(ts|tsx|js|jsx|kt|kts|py|go|java|sql|sh|yaml|yml|json|properties)$|\\\\.env(\\\\.[A-Za-z0-9_-]+)?$\"",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/warn-security.js"]
          }
        ],
        "description": "Warn about high-signal security patterns (secrets, injection, unsafe deserialization, TLS bypass, XSS) after Write on code files"
      }
    ]
  }
}
