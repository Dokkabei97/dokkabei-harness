{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/block-dev-server.js"]
          }
        ],
        "description": "Block dev servers outside tmux - ensures you can access logs (includes Python servers). 명령 패턴 필터는 스크립트 내부 — matcher 는 tool 명 regex 만 유효(표현식 미발화 실측, 2026-07)"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/warn-tmux.js"]
          }
        ],
        "description": "Reminder to use tmux for long-running commands (includes gradlew, pip, uv). 명령 패턴 필터는 스크립트 내부"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/warn-git-push.js"]
          }
        ],
        "description": "Reminder before git push to review changes. 명령 패턴 필터는 스크립트 내부"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/log-pr-mr.js"]
          }
        ],
        "description": "Log PR/MR URL and provide review command after GitHub PR or GitLab MR creation"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/notify-build-async.js"],
            "async": true,
            "timeout": 30
          }
        ],
        "description": "Async hook for npm/pnpm/yarn build analysis (runs in background without blocking). 명령 패턴 필터는 스크립트 내부"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/notify-gradle-build-async.js"],
            "async": true,
            "timeout": 60
          }
        ],
        "description": "Async hook for Gradle build analysis (runs in background without blocking). 명령 패턴 필터는 스크립트 내부"
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/format-prettier.js"]
          }
        ],
        "description": "Auto-format JS/TS files with Prettier after edits. 확장자 필터는 스크립트 내부"
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/format-ktlint.js"]
          }
        ],
        "description": "Auto-format Kotlin files with ktlintFormat after edits. 확장자 필터는 스크립트 내부"
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/check-tsc.js"]
          }
        ],
        "description": "TypeScript check after editing .ts/.tsx files. 확장자 필터는 스크립트 내부"
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/check-kotlin-compile.js"]
          }
        ],
        "description": "Kotlin compile check after editing .kt/.kts files. 확장자 필터는 스크립트 내부"
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/warn-console-log.js"]
          }
        ],
        "description": "Warn about console.log statements after JS/TS edits. 확장자 필터는 스크립트 내부"
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/warn-println.js"]
          }
        ],
        "description": "Warn about println() statements after Kotlin edits. 확장자 필터는 스크립트 내부"
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/check-py-compile.js"]
          }
        ],
        "description": "Python syntax check with py_compile after editing .py files. 확장자 필터는 스크립트 내부"
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/warn-print.js"]
          }
        ],
        "description": "Warn about print() statements after Python edits"
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/warn-security.js"]
          }
        ],
        "description": "Warn about high-signal security patterns (secrets, injection, unsafe deserialization, TLS bypass, XSS) after Edit on code files. 확장자 필터는 스크립트 내부 — matcher 는 tool 명 regex 만 유효(표현식 미발화 실측, 2026-07)"
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hooks/warn-security.js"]
          }
        ],
        "description": "Warn about high-signal security patterns (secrets, injection, unsafe deserialization, TLS bypass, XSS) after Write on code files. 확장자 필터는 스크립트 내부"
      }
    ]
  }
}
